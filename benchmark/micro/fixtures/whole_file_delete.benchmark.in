# name: benchmark/micro/fixtures/whole_file_delete.benchmark.in
# description: Lake with a table of 5M rows in one file that a later snapshot deleted whole, and one with a single deleted row
# group: [fixtures]

argument lake whole_file_delete_v1

cache_file ${lake}_ready.marker

# Snapshot 1 creates w, 2 deletes all of it; snapshot 3 creates p, 4 deletes one of its rows into a delete file
load
@create ${lake}_pristine
@attach ${lake}_pristine AS lake (DATA_PATH '${BENCHMARK_DIR}/${lake}_files')
CALL lake.set_option('data_inlining_row_limit', 0);
CREATE TABLE lake.w AS SELECT i::BIGINT AS id FROM range(5000000) t(i);
DELETE FROM lake.w;
CREATE TABLE lake.p AS SELECT i::BIGINT AS id FROM range(5000000) t(i);
DELETE FROM lake.p WHERE id = 0;
SELECT CASE WHEN (SELECT count(*) <> 1 OR max(record_count) <> 5000000 FROM __ducklake_metadata_lake.ducklake_data_file WHERE end_snapshot = 2)
OR (SELECT count(*) <> 1 FROM __ducklake_metadata_lake.ducklake_delete_file WHERE end_snapshot IS NULL AND delete_count = 1)
OR (SELECT count(*) <> 5 FROM lake.snapshots())
THEN error('unexpected whole file delete fixture') END;
CALL ducklake_delete_orphaned_files('lake', cleanup_all => true);
DETACH lake;
COPY (SELECT count(*) FROM glob('${BENCHMARK_DIR}/${lake}_files/**'))
TO '${BENCHMARK_DIR}/${lake}_filecount.csv' (FORMAT CSV, HEADER false);
@seal ${lake}_pristine
COPY (SELECT 1) TO '${BENCHMARK_DIR}/${lake}_ready.marker' (FORMAT CSV);
DETACH DATABASE IF EXISTS lake;
@copy ${lake}_pristine TO ${work}
@attach ${work} AS lake
CALL ducklake_delete_orphaned_files('lake', cleanup_all => true);
SELECT CASE WHEN (SELECT count(*) FROM glob('${BENCHMARK_DIR}/${lake}_files/**'))
<> (SELECT column0 FROM read_csv('${BENCHMARK_DIR}/${lake}_filecount.csv', header = false))
THEN error('the fixture files were not restored') END;

include benchmark/micro/fixtures/restore_reload.benchmark.in
