# name: benchmark/micro/maintenance/flush_inlined_schema_versions.benchmark
# description: Flush 300 inlined tables whose rows each sit in a schema version of their own, with commit
# group: [maintenance]

name Flush Inlined Schema Versions
group micro
subgroup maintenance

require ducklake

require parquet

argument work flush_schema_versions_work

include benchmark/micro/fixtures/flush_schema_versions.benchmark.in

include benchmark/micro/fixtures/restore_cleanup.benchmark.in

run
SELECT count(*) FILTER (WHERE rows_flushed > 0) AS tables_flushed, sum(rows_flushed) AS rows_flushed
FROM ducklake_flush_inlined_data('lake');

result_query III
SELECT tables_flushed, rows_flushed,
(SELECT count(*) = 300 AND sum(record_count) = 300
FROM __ducklake_metadata_lake.ducklake_data_file WHERE end_snapshot IS NULL)
FROM __answer
----
300	300	true
