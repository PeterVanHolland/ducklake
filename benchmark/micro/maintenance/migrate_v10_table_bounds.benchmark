# name: benchmark/micro/maintenance/migrate_v10_table_bounds.benchmark
# description: Attach a v1.0 lake of 100 tables with ten data files each, migrating it to v1.1
# group: [maintenance]

name Migrate v1.0 Table Bounds
group micro
subgroup maintenance

require ducklake

require parquet

argument lake migrate_v10_bounds_v1

argument work migrate_v10_bounds_work

cache_file ${lake}_ready.marker

# Every table has ten files with bounds for its three columns, which the migration compares with the table bounds
load
@create ${lake}_pristine
@attach ${lake}_pristine AS lake (DATA_PATH '${BENCHMARK_DIR}/${lake}_files', DUCKLAKE_VERSION '1.0', DATA_INLINING_ROW_LIMIT 0)
@for k in range(100)
CREATE TABLE lake.t@{k} (id INTEGER, v VARCHAR, d DECIMAL(18, 4));
@for f in range(10)
INSERT INTO lake.t@{k} VALUES (@{f}, 'v@{f}', @{f}.5);
@end
@end
SELECT CASE WHEN (SELECT count(*) <> 3000 FROM __ducklake_metadata_lake.ducklake_file_column_stats)
THEN error('unexpected migration fixture') END;
DETACH lake;
@seal ${lake}_pristine
COPY (SELECT 1) TO '${BENCHMARK_DIR}/${lake}_ready.marker' (FORMAT CSV);
@copy ${lake}_pristine TO ${work}

reload
DETACH DATABASE IF EXISTS lake;
@copy ${lake}_pristine TO ${work}

cleanup
DETACH DATABASE IF EXISTS lake;
@copy ${lake}_pristine TO ${work}

run
@attach ${work} AS lake (DATA_PATH '${BENCHMARK_DIR}/${lake}_files', DUCKLAKE_VERSION '1.1', AUTOMATIC_MIGRATION TRUE)

result_query III
SELECT (SELECT value FROM __ducklake_metadata_lake.ducklake_metadata WHERE key = 'version'), count(*), sum(id)
FROM lake.t99
----
1.1	10	45
