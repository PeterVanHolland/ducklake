# name: benchmark/micro/read/big_lake_cold_listing.benchmark.in
# description: Three cold attaches of a lake with 2110 populated tables that list their sizes and column counts
# group: [read]

include benchmark/micro/fixtures/big_lake.benchmark.in

# Three cold attaches, the estimated sizes come from the table stats of every table
run
SELECT count(*), sum(estimated_size), sum(column_count) FROM duckdb_tables() WHERE database_name = 'lake';
DETACH lake;
@attach ${work} AS lake
SELECT count(*), sum(estimated_size), sum(column_count) FROM duckdb_tables() WHERE database_name = 'lake';
DETACH lake;
@attach ${work} AS lake
SELECT count(*), sum(estimated_size), sum(column_count) FROM duckdb_tables() WHERE database_name = 'lake';

# Reattaching gives every run cold schema and stats caches
cleanup
DETACH lake;
@attach ${work} AS lake

result_query III
SELECT * FROM __answer
----
2110	34800	20220
