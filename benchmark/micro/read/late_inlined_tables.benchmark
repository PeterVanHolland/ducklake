# name: benchmark/micro/read/late_inlined_tables.benchmark
# description: Run 120 small autocommit scans of 40 tables whose inlined data tables were created after them, warm
# group: [read]

name Late Inlined Tables
group micro
subgroup read

require ducklake

cache_file late_inlined_ready.marker

# The tables are created without inlining, so a later commit creates their 40 inlined data tables
load
@create late_inlined
@attach late_inlined AS lake (DATA_PATH '${BENCHMARK_DIR}/late_inlined_files', DATA_INLINING_ROW_LIMIT 0)
BEGIN;
@for k in range(40)
CREATE TABLE lake.late_@{k} (id INTEGER, v VARCHAR);
@end
COMMIT;
CALL lake.set_option('data_inlining_row_limit', 10);
BEGIN;
@for k in range(40)
INSERT INTO lake.late_@{k} SELECT r, 'v' || (r + @{k}) FROM range(5) t(r);
@end
COMMIT;
SELECT CASE WHEN (SELECT count(*) <> 40 OR count(DISTINCT table_id) <> 40
FROM __ducklake_metadata_lake.ducklake_inlined_data_tables)
OR (SELECT count(*) <> 0 FROM __ducklake_metadata_lake.ducklake_inlined_data_tables
JOIN __ducklake_metadata_lake.ducklake_schema_versions USING (table_id, schema_version))
OR (SELECT count(*) <> 0 FROM glob('${BENCHMARK_DIR}/late_inlined_files/**'))
THEN error('every table must have one inlined data table without a schema version row and no data file') END;
DETACH lake;
@seal late_inlined
COPY (SELECT 1) TO '${BENCHMARK_DIR}/late_inlined_ready.marker' (FORMAT CSV);
@attach late_inlined AS lake (READ_ONLY)

reload
@attach late_inlined AS lake (READ_ONLY)

# The run only reads, and its discarded warmup run fills the caches
run benchmark/micro/queries/late_inlined_tables.sql

result_query I
SELECT * FROM __answer
----
v1
