# name: benchmark/micro/read/list_many_delete_files.benchmark
# description: Read one row of a table with 4096 data files that each have a delete file, 20 times
# group: [read]

name List Many Delete Files
group micro
subgroup read

require ducklake

require parquet

argument work list_many_delete_files_work

include benchmark/micro/fixtures/delete_files.benchmark.in

run
@for i in range(20)
SELECT count(*) FROM (SELECT id FROM lake.bg LIMIT 1);
@end

result_query I
SELECT * FROM __answer
----
1
