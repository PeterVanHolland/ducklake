# name: benchmark/micro/read/shared_begin_inlined_reads.benchmark
# description: Scan 20 freshly attached tables whose inlined rows are at a schema version that shares its begin
# group: [read]

name Shared Begin Inlined Reads
group micro
subgroup read

require ducklake

require parquet

argument lake shared_begin_inlined_v1

argument work shared_begin_inlined_work

cache_file ${lake}_ready.marker

init
SET VARIABLE shared_begin_tables = (SELECT list('lake.t' || i ORDER BY i) FROM range(20) t(i));

# Every statement is a commit, so each table has snapshots of its own
# The schema versions of a table then get the begin of its creation, as the migration of DuckDB 1.5.1 leaves them
load
@create ${lake}_pristine
@attach ${lake}_pristine AS lake (DATA_PATH '${BENCHMARK_DIR}/${lake}_files')
CALL lake.set_option('data_inlining_row_limit', 10);
@for k in range(20)
CREATE TABLE lake.t@{k} (id INTEGER, v INTEGER);
ALTER TABLE lake.t@{k} ALTER COLUMN v SET DEFAULT 5;
INSERT INTO lake.t@{k} VALUES (1, @{k});
ALTER TABLE lake.t@{k} ADD COLUMN w INTEGER;
@end
UPDATE __ducklake_metadata_lake.ducklake_schema_versions SET begin_snapshot = 4 * table_id - 3;
SELECT CASE WHEN (SELECT count(*) <> 60 FROM __ducklake_metadata_lake.ducklake_schema_versions)
OR (SELECT count(*) <> 0 FROM __ducklake_metadata_lake.ducklake_schema_versions versions
JOIN __ducklake_metadata_lake.ducklake_table tables USING (table_id)
WHERE versions.begin_snapshot <> tables.begin_snapshot)
OR (SELECT count(*) <> 60 FROM __ducklake_metadata_lake.ducklake_inlined_data_tables)
THEN error('unexpected shared begin fixture') END;
DETACH lake;
@seal ${lake}_pristine
COPY (SELECT 1) TO '${BENCHMARK_DIR}/${lake}_ready.marker' (FORMAT CSV);
@copy ${lake}_pristine TO ${work}
@attach ${work} AS lake

reload
DETACH DATABASE IF EXISTS lake;
@copy ${lake}_pristine TO ${work}
@attach ${work} AS lake

# A sum reads the inlined rows instead of answering from the table stats
run
SELECT count(*), sum(v) FROM query_table(getvariable('shared_begin_tables'));

# Every run attaches again, so its schema cache is cold
cleanup
DETACH lake;
@attach ${work} AS lake

result_query II
SELECT * FROM __answer
----
20	190
