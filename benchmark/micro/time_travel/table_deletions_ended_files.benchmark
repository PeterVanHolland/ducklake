# name: benchmark/micro/time_travel/table_deletions_ended_files.benchmark
# description: table_deletions over a delete of every row of 4096 data files that each have a delete file
# group: [time_travel]

name Table Deletions Ended Files
group micro
subgroup time_travel

require ducklake

require parquet

argument work table_deletions_ended_files_work

include benchmark/micro/fixtures/delete_files.benchmark.in

include benchmark/micro/fixtures/restore_cleanup.benchmark.in

run
DELETE FROM lake.bg;
SELECT snapshot_id, count(*) AS cnt, sum(id) AS sum_id FROM ducklake_table_deletions('lake', 'main', 'bg', 5, 5)
GROUP BY ALL ORDER BY ALL;

result III
5	8384512	35167192219648
