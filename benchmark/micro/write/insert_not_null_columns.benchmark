# name: benchmark/micro/write/insert_not_null_columns.benchmark
# description: INSERT of TPC-H lineitem SF0.5 (3M rows) into a table with 16 NOT NULL columns, including the commit
# group: [write]

name Insert Not Null Columns
group micro
subgroup write

require ducklake

require parquet

require tpch

argument lake ctas

argument work not_null_columns_work

include benchmark/micro/fixtures/tpch05.benchmark.in

include benchmark/micro/fixtures/restore_cleanup.benchmark.in

run
CREATE TABLE lake.items (l_orderkey BIGINT NOT NULL, l_partkey BIGINT NOT NULL, l_suppkey BIGINT NOT NULL,
l_linenumber BIGINT NOT NULL, l_quantity DECIMAL(15, 2) NOT NULL, l_extendedprice DECIMAL(15, 2) NOT NULL,
l_discount DECIMAL(15, 2) NOT NULL, l_tax DECIMAL(15, 2) NOT NULL, l_returnflag VARCHAR NOT NULL,
l_linestatus VARCHAR NOT NULL, l_shipdate DATE NOT NULL, l_commitdate DATE NOT NULL, l_receiptdate DATE NOT NULL,
l_shipinstruct VARCHAR NOT NULL, l_shipmode VARCHAR NOT NULL, l_comment VARCHAR NOT NULL);
INSERT INTO lake.items FROM src.lineitem;

# A missed reset makes the CREATE TABLE fail because lake.items already exists
result_query II
SELECT Count = (SELECT count(*) FROM src.lineitem),
(SELECT sum(hash(*COLUMNS(*))) FROM lake.items) = (SELECT sum(hash(*COLUMNS(*))) FROM src.lineitem)
FROM __answer
----
true	true
