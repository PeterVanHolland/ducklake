# name: test/sql/add_files/add_files_shared_local_file_delete.test
# description: a delete that empties a file written in the transaction keeps the file while another table added it
# group: [add_files]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/add_files_shared_local_file_delete', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE ducklake.t(i INTEGER)

statement ok
CREATE TABLE ducklake.u(i INTEGER)

# u adds the file t wrote in this transaction, then t deletes all of its rows
statement ok
BEGIN

statement ok
INSERT INTO ducklake.t VALUES (1)

statement ok
SET VARIABLE shared = (SELECT filename FROM ducklake.t LIMIT 1)

statement ok
CALL ducklake_add_data_files('ducklake', 'u', getvariable('shared'))

statement ok
DELETE FROM ducklake.t

query II
SELECT count(*), sum(i) FROM ducklake.u
----
1	1

query I
SELECT count(*) FROM ducklake.t
----
0

statement ok
COMMIT

query II
SELECT count(*), sum(i) FROM ducklake.u
----
1	1

query I
SELECT count(*) FROM ducklake.t
----
0

query I
SELECT count(*) FROM glob('{DATA_PATH}/add_files_shared_local_file_delete/main/t/*.parquet')
----
1

# a rollback removes the file the transaction wrote, even after the table that wrote it dropped it
statement ok
BEGIN

statement ok
INSERT INTO ducklake.t VALUES (2)

statement ok
SET VARIABLE shared = (SELECT filename FROM ducklake.t LIMIT 1)

statement ok
CALL ducklake_add_data_files('ducklake', 'u', getvariable('shared'))

statement ok
DELETE FROM ducklake.t

query II
SELECT count(*), sum(i) FROM ducklake.u
----
2	3

statement ok
ROLLBACK

query I
SELECT count(*) FROM glob('{DATA_PATH}/add_files_shared_local_file_delete/main/t/*.parquet')
----
1

# when both tables drop the file in the transaction, it is removed
statement ok
BEGIN

statement ok
INSERT INTO ducklake.t VALUES (3)

statement ok
SET VARIABLE shared = (SELECT filename FROM ducklake.t LIMIT 1)

statement ok
CALL ducklake_add_data_files('ducklake', 'u', getvariable('shared'))

statement ok
DELETE FROM ducklake.t

statement ok
DELETE FROM ducklake.u

query I
SELECT count(*) FROM ducklake.u
----
0

statement ok
COMMIT

query I
SELECT count(*) FROM glob('{DATA_PATH}/add_files_shared_local_file_delete/main/t/*.parquet')
----
1

query II
SELECT (SELECT count(*) FROM ducklake.t), (SELECT count(*) FROM ducklake.u)
----
0	0

# the table that added the file drops it first, the writer removes it afterwards
statement ok
BEGIN

statement ok
INSERT INTO ducklake.t VALUES (4)

statement ok
SET VARIABLE shared = (SELECT filename FROM ducklake.t LIMIT 1)

statement ok
CALL ducklake_add_data_files('ducklake', 'u', getvariable('shared'))

statement ok
DELETE FROM ducklake.u

query I
SELECT count(*) FROM ducklake.t
----
1

statement ok
DELETE FROM ducklake.t

statement ok
COMMIT

query I
SELECT count(*) FROM glob('{DATA_PATH}/add_files_shared_local_file_delete/main/t/*.parquet')
----
1

query I
SELECT count(*) FROM ducklake.u AT (VERSION => 3)
----
1
