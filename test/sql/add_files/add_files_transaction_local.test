# name: test/sql/add_files/add_files_transaction_local.test
# description: test ducklake adding files to a transaction-local table
# group: [add_files]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}


statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/ducklake_add_files_transaction_local');

statement ok
BEGIN

statement ok
CREATE TABLE ducklake.test(col1 INTEGER, col2 VARCHAR);

# write a parquet file outside of DuckLake
statement ok
COPY (SELECT 1 col1, 'hello world' col2) TO '{DATA_PATH}/my_file.parquet';

statement ok
CALL ducklake_add_data_files('ducklake', 'test', '{DATA_PATH}/my_file.parquet')

query II
FROM ducklake.test
----
1	hello world

statement ok
COMMIT

query II
FROM ducklake.test
----
1	hello world

# a table that is dropped in the transaction that created it takes the name map of its added file with it
statement ok
BEGIN

statement ok
CREATE TABLE ducklake.dropped(col1 INTEGER, col2 VARCHAR);

statement ok
CALL ducklake_add_data_files('ducklake', 'dropped', '{DATA_PATH}/my_file.parquet')

statement ok
DROP TABLE ducklake.dropped

statement ok
COMMIT

# the statement that replaces such a table reads the added file
statement ok
BEGIN

statement ok
CREATE TABLE ducklake.replaced(col1 INTEGER, col2 VARCHAR);

statement ok
CALL ducklake_add_data_files('ducklake', 'replaced', '{DATA_PATH}/my_file.parquet')

statement ok
CREATE OR REPLACE TABLE ducklake.replaced AS SELECT col1 + 1 AS col1, col2 FROM ducklake.replaced

statement ok
COMMIT

query II
FROM ducklake.replaced
----
2	hello world

# the added file is not removed with the table
query II
FROM ducklake.test
----
1	hello world
