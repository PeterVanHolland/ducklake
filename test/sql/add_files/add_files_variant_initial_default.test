# name: test/sql/add_files/add_files_variant_initial_default.test
# description: a VARIANT default that is not a string has no initial default, so rows of added files read NULL
# group: [add_files]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS lake (DATA_PATH '{DATA_PATH}/variant_initial_default', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE lake.t (i INTEGER, v VARIANT DEFAULT 42, s VARIANT DEFAULT 'abc', n VARIANT DEFAULT NULL, j VARIANT DEFAULT {'a': 1}, cv VARIANT DEFAULT 'abc'::VARIANT, b VARIANT DEFAULT 'abc'::BLOB, d VARIANT DEFAULT 1.5)

# the catalog keeps the initial default as text, which only keeps the type of a string
query II
SELECT column_name, initial_default FROM __ducklake_metadata_lake.ducklake_column
WHERE column_name <> 'i' ORDER BY column_id
----
v	NULL
s	abc
n	NULL
j	NULL
cv	abc
b	NULL
d	NULL

statement ok
COPY (SELECT 1 AS i) TO '{DATA_PATH}/variant_initial_default_missing.parquet'

statement ok
CALL ducklake_add_data_files('lake', 't', '{DATA_PATH}/variant_initial_default_missing.parquet', allow_missing => true)

# the missing columns read the string defaults and NULL for the others, not the text of the number
query IIIIIIII
SELECT i, v, variant_typeof(s), s::VARCHAR, j, variant_typeof(cv), b, d FROM lake.t
----
1	NULL	VARCHAR	abc	NULL	VARCHAR	NULL	NULL

statement ok
DETACH lake

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS lake (DATA_PATH '{DATA_PATH}/variant_initial_default', DATA_INLINING_ROW_LIMIT 0)

query IIIIIIII
SELECT i, v, variant_typeof(s), s::VARCHAR, j, variant_typeof(cv), b, d FROM lake.t
----
1	NULL	VARCHAR	abc	NULL	VARCHAR	NULL	NULL

# a string default of a VARIANT column keeps working for an added file
statement ok
CREATE TABLE lake.t2 (i INTEGER, s VARIANT DEFAULT '42')

statement ok
CALL ducklake_add_data_files('lake', 't2', '{DATA_PATH}/variant_initial_default_missing.parquet', allow_missing => true)

query III
SELECT i, variant_typeof(s), s::VARCHAR FROM lake.t2
----
1	VARCHAR	42

# a field added to a struct keeps the text of its default, the rows that exist read it
statement ok
CREATE TABLE lake.t3 (i INTEGER, s STRUCT(a INTEGER))

statement ok
INSERT INTO lake.t3 VALUES (1, {'a': 1})

statement ok
ALTER TABLE lake.t3 ADD COLUMN s.v VARIANT DEFAULT 42

query II
SELECT c.column_name, c.initial_default FROM __ducklake_metadata_lake.ducklake_column c
JOIN __ducklake_metadata_lake.ducklake_table t USING (table_id)
WHERE t.table_name = 't3' AND c.column_name = 'v' AND c.end_snapshot IS NULL
----
v	42

query II
SELECT i, s.v::VARCHAR FROM lake.t3
----
1	42
