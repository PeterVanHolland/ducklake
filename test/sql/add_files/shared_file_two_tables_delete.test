# name: test/sql/add_files/shared_file_two_tables_delete.test
# description: Deleting the rows of a file registered in two tables keeps it visible to the other table in the same transaction
# group: [add_files]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta', DATA_INLINING_ROW_LIMIT 0)

statement ok
COPY (SELECT range::INTEGER AS i FROM range(5)) TO '{DATA_PATH}/{BASE_TEST_NAME}_shared.parquet'

statement ok
CREATE TABLE dl.t(i INTEGER)

statement ok
CREATE TABLE dl.u(i INTEGER)

statement ok
CALL ducklake_add_data_files('dl', 't', '{DATA_PATH}/{BASE_TEST_NAME}_shared.parquet')

statement ok
CALL ducklake_add_data_files('dl', 'u', '{DATA_PATH}/{BASE_TEST_NAME}_shared.parquet')

statement ok
BEGIN

statement ok
DELETE FROM dl.t

query I
SELECT count(*) FROM dl.t
----
0

query II
SELECT count(*), sum(i) FROM dl.u
----
5	10

statement ok
ROLLBACK

query II
SELECT (SELECT count(*) FROM dl.t), (SELECT count(*) FROM dl.u)
----
5	5

# the commit drops the file from the deleted table only
statement ok
BEGIN

statement ok
DELETE FROM dl.t

query II
SELECT count(*), sum(i) FROM dl.u
----
5	10

statement ok
COMMIT

query II
SELECT (SELECT count(*) FROM dl.t), (SELECT count(*) FROM dl.u)
----
0	5

# two registrations of the path dropped in one transaction
statement ok
CREATE TABLE dl.v(i INTEGER)

statement ok
CALL ducklake_add_data_files('dl', 'v', '{DATA_PATH}/{BASE_TEST_NAME}_shared.parquet')

statement ok
BEGIN

statement ok
DELETE FROM dl.u

statement ok
DELETE FROM dl.v

query II
SELECT (SELECT count(*) FROM dl.u), (SELECT count(*) FROM dl.v)
----
0	0

statement ok
COMMIT

query III
SELECT (SELECT count(*) FROM dl.t), (SELECT count(*) FROM dl.u), (SELECT count(*) FROM dl.v)
----
0	0	0
