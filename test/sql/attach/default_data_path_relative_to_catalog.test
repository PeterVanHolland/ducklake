# name: test/sql/attach/default_data_path_relative_to_catalog.test
# description: A DuckDB file catalog stores its default data path relative to the catalog file and resolves a relative data path against the catalog's directory
# group: [attach]

require ducklake

require parquet

# the default data path of a new lake is stored relative to the catalog file
statement ok
ATTACH 'ducklake:{TEST_DIR}/relative_lake.ducklake' AS lake (DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE lake.t AS SELECT range AS i FROM range(10)

query I
SELECT value FROM __ducklake_metadata_lake.ducklake_metadata WHERE key = 'data_path'
----
relative_lake.ducklake.files/

# the session works with the resolved path next to the catalog file
query I
SELECT count(*) FROM glob('{TEST_DIR}/relative_lake.ducklake.files/main/t/*.parquet')
----
1

# every path below the data path is relative as well, so the lake can be moved as a whole
query III
SELECT (SELECT path FROM __ducklake_metadata_lake.ducklake_schema), (SELECT path FROM __ducklake_metadata_lake.ducklake_table), (SELECT path_is_relative FROM __ducklake_metadata_lake.ducklake_data_file)
----
main/	t/	true

query I
SELECT sum(i) FROM lake.t
----
45

statement ok
DETACH lake

# a plain attach resolves the stored relative path against the catalog's directory
statement ok
ATTACH 'ducklake:{TEST_DIR}/relative_lake.ducklake' AS lake

query I
SELECT sum(i) FROM lake.t
----
45

statement ok
INSERT INTO lake.t VALUES (100)

query I
SELECT sum(i) FROM lake.t
----
145

statement ok
DETACH lake

# the resolved path given as DATA_PATH matches the stored relative one
statement ok
ATTACH 'ducklake:{TEST_DIR}/relative_lake.ducklake' AS lake (DATA_PATH '{TEST_DIR}/relative_lake.ducklake.files/')

query I
SELECT sum(i) FROM lake.t
----
145

statement ok
DETACH lake

# another data path is still refused without OVERRIDE_DATA_PATH
statement error
ATTACH 'ducklake:{TEST_DIR}/relative_lake.ducklake' AS lake (DATA_PATH '{TEST_DIR}/elsewhere/')
----
does not match existing data path in the catalog "relative_lake.ducklake.files/"

# an explicit relative DATA_PATH is stored as written and lies next to the catalog file, not in the working directory
statement ok
ATTACH 'ducklake:{TEST_DIR}/relative_lake2.ducklake' AS lake2 (DATA_PATH 'lake2_files/', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE lake2.t AS SELECT range AS i FROM range(10)

query I
SELECT value FROM __ducklake_metadata_lake2.ducklake_metadata WHERE key = 'data_path'
----
lake2_files/

query I
SELECT count(*) FROM glob('{TEST_DIR}/lake2_files/main/t/*.parquet')
----
1

statement ok
DETACH lake2

statement ok
ATTACH 'ducklake:{TEST_DIR}/relative_lake2.ducklake' AS lake2

query I
SELECT sum(i) FROM lake2.t
----
45

# a lake created before stored its relative data path against the working directory, where it is still found
unzip data/old_ducklake/migrate_bounds.db.gz {TEST_DIR}/legacy_working_directory.db

statement ok
ATTACH 'ducklake:{TEST_DIR}/legacy_working_directory.db' AS legacy (METADATA_CATALOG 'legacy_meta', DUCKLAKE_VERSION '1.1', AUTOMATIC_MIGRATION TRUE)

query I
SELECT value FROM legacy_meta.ducklake_metadata WHERE key = 'data_path'
----
data/old_ducklake/migrate_bounds/

query I
SELECT count(*) FROM legacy.dbl2 WHERE f = 0.1
----
1

# a stored relative path that exists nowhere resolves next to the catalog file, not in the working directory
unzip data/old_ducklake/dropped_in_transaction.db.gz {TEST_DIR}/legacy_missing_directory.db

statement ok
ATTACH 'ducklake:{TEST_DIR}/legacy_missing_directory.db' AS legacy2 (DUCKLAKE_VERSION '1.1', AUTOMATIC_MIGRATION TRUE)

query I
SELECT value FROM __ducklake_metadata_legacy2.ducklake_metadata WHERE key = 'data_path'
----
lake_files/

statement error
SELECT * FROM legacy2.t
----
<REGEX>:.*Cannot open file.*[/\\]lake_files[/\\]main[/\\]t[/\\].*

# objects created in the transaction of the attach use the resolved data path as well
statement ok
BEGIN

statement ok
ATTACH 'ducklake:{TEST_DIR}/relative_lake3.ducklake' AS lake3 (DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE SCHEMA lake3.s1

statement ok
CREATE TABLE lake3.s1.t AS SELECT range AS i FROM range(10)

statement ok
COMMIT

query II
SELECT path, path_is_relative FROM __ducklake_metadata_lake3.ducklake_schema ORDER BY schema_id
----
main/	true
s1/	true

query II
SELECT path, path_is_relative FROM __ducklake_metadata_lake3.ducklake_table
----
t/	true

query I
SELECT count(*) FROM glob('{TEST_DIR}/relative_lake3.ducklake.files/s1/t/*.parquet')
----
1

statement ok
DETACH lake3

statement ok
ATTACH 'ducklake:{TEST_DIR}/relative_lake3.ducklake' AS lake3

query I
SELECT sum(i) FROM lake3.s1.t
----
45

# "." and ".." segments and doubled separators of a relative DATA_PATH are left out of the resolved path, so the
# file paths stay relative
statement ok
ATTACH 'ducklake:{TEST_DIR}/relative_lake5.ducklake' AS lake5 (DATA_PATH './sub/..//lake5_files/', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE lake5.t AS SELECT range AS i FROM range(10)

query I
SELECT value FROM __ducklake_metadata_lake5.ducklake_metadata WHERE key = 'data_path'
----
./sub/..//lake5_files/

query I
SELECT path_is_relative FROM __ducklake_metadata_lake5.ducklake_data_file
----
true

query I
SELECT count(*) FROM glob('{TEST_DIR}/lake5_files/main/t/*.parquet')
----
1

statement ok
DETACH lake5

statement ok
ATTACH 'ducklake:{TEST_DIR}/relative_lake5.ducklake' AS lake5

query I
SELECT sum(i) FROM lake5.t
----
45

# the default data path of a catalog file whose name starts with "~" gets a "./" prefix, the file system would read
# a leading "~" as the home directory
statement ok
ATTACH 'ducklake:{TEST_DIR}/~tilde_lake.ducklake' AS tilde (DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE tilde.t AS SELECT range AS i FROM range(10)

query I
SELECT value FROM __ducklake_metadata_tilde.ducklake_metadata WHERE key = 'data_path'
----
./~tilde_lake.ducklake.files/

statement ok
DETACH tilde

statement ok
ATTACH 'ducklake:{TEST_DIR}/~tilde_lake.ducklake' AS tilde

query I
SELECT sum(i) FROM tilde.t
----
45
