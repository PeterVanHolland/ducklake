# name: test/sql/catalog/nested_schema/nested_main_schema.test
# description: A nested schema named main is not the default schema and is replaced and dropped like any other
# group: [nested_schema]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DUCKLAKE_VERSION '1.1', DATA_PATH '{DATA_PATH}/nested_main_schema')

statement ok
CREATE SCHEMA ducklake.a

statement ok
CREATE SCHEMA ducklake.a.main

statement ok
CREATE OR REPLACE SCHEMA ducklake.a.main

query I
SELECT changes FROM ducklake_snapshots('ducklake') ORDER BY snapshot_id DESC LIMIT 1
----
{schemas_created=[a.main], schemas_dropped=[2]}

statement error
CREATE OR REPLACE SCHEMA ducklake.main
----
Cannot drop entry "main" because it is the default schema

statement ok
CREATE TABLE ducklake.a.main.t (i INTEGER)

statement ok
DROP SCHEMA ducklake.a CASCADE

query I
SELECT schema_name FROM duckdb_schemas() WHERE database_name = 'ducklake'
----
main
