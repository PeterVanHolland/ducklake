# name: test/sql/cleanup/expire_cleanup_concurrent_commit.test
# description: On a 1.1 catalog a retried commit keeps the expiry and the cleanup
# group: [cleanup]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl
(DATA_PATH '{DATA_PATH}/expire_cleanup_concurrent_commit', DATA_INLINING_ROW_LIMIT 0, DUCKLAKE_VERSION '1.1')

statement ok
CREATE TABLE dl.t AS SELECT 42 AS i

statement ok
DELETE FROM dl.t

statement ok
CREATE TABLE dl.u (i INTEGER)

# the retry expires snapshot 1 again
statement ok a
BEGIN

statement ok a
CALL ducklake_expire_snapshots('dl', versions => [1])

statement ok a
INSERT INTO dl.t VALUES (10)

statement ok b
INSERT INTO dl.u VALUES (20)

statement ok a
COMMIT

query III
SELECT (SELECT count(*) FROM dl.snapshots() WHERE snapshot_id = 1), (SELECT sum(i) FROM dl.t),
       (SELECT sum(i) FROM dl.u)
----
0	10	20

statement error
SELECT i FROM dl.t AT (VERSION => 1)
----
No snapshot found

# the retry removes the cleaned up files from the schedule again
statement ok a
BEGIN

statement ok a
CALL ducklake_cleanup_old_files('dl', cleanup_all => true)

statement ok a
INSERT INTO dl.t VALUES (10)

statement ok b
INSERT INTO dl.u VALUES (30)

statement ok a
COMMIT

query III
SELECT (SELECT count(*) FROM __ducklake_metadata_dl.ducklake_files_scheduled_for_deletion),
       (SELECT sum(i) FROM dl.t), (SELECT sum(i) FROM dl.u)
----
0	20	50
