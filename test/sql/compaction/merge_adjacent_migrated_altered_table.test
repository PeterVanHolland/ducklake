# name: test/sql/compaction/merge_adjacent_migrated_altered_table.test
# description: compaction of a table that was altered before DuckDB 1.5.0 or 1.5.1 migrated its schema versions
# group: [compaction]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl
	(DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE dl.t (a INTEGER)

statement ok
INSERT INTO dl.t VALUES (1)

statement ok
ALTER TABLE dl.t ADD COLUMN b INTEGER

statement ok
INSERT INTO dl.t VALUES (2, 20)

statement ok
INSERT INTO dl.t VALUES (3, 30)

# DuckDB 1.5.0 and 1.5.1 gave every schema version of a table the snapshot of its creation
statement ok
UPDATE __ducklake_metadata_dl.ducklake_schema_versions SET begin_snapshot = 1

statement ok
DETACH dl

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files')

# the latest schema no longer has the column the table was created with
statement ok
ALTER TABLE dl.t DROP COLUMN a

# a snapshot of the schema version of the files
query I
SELECT count(*) FROM dl.t AT (VERSION => 5)
----
3

query IIII
CALL ducklake_merge_adjacent_files('dl', 't')
----
main	t	3	1

# the merged file keeps the column that was added before the migration
query I
SELECT b FROM dl.t ORDER BY ALL
----
20
30
NULL
