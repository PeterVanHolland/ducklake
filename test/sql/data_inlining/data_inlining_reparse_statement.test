# name: test/sql/data_inlining/data_inlining_reparse_statement.test
# description: Inlined rows commit while debug_verify_statement reparses every statement
# group: [data_inlining]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/reparse_files', DATA_INLINING_ROW_LIMIT 10)

# the verifier turns every statement into SQL text and parses it again, including the statements of a commit
statement ok
SET debug_verify_statement = 'reparse_statement'

statement ok
CREATE TABLE ducklake.t AS SELECT 1 AS i

statement ok
INSERT INTO ducklake.t VALUES (2), (3)

query I
SELECT i FROM ducklake.t ORDER BY i
----
1
2
3
