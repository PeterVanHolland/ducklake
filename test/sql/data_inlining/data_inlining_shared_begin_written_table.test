# name: test/sql/data_inlining/data_inlining_shared_begin_written_table.test
# description: rows inlined at schema versions that share a begin are read with the table they were written for
# group: [data_inlining]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl
	(DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', DATA_INLINING_ROW_LIMIT 10)

# the column b of p is replaced by another one of its name
statement ok
CREATE TABLE dl.p (a INTEGER, b INTEGER)

statement ok
INSERT INTO dl.p VALUES (1, 10)

statement ok
BEGIN

statement ok
ALTER TABLE dl.p DROP COLUMN b

statement ok
ALTER TABLE dl.p ADD COLUMN b INTEGER

statement ok
COMMIT

statement ok
INSERT INTO dl.p VALUES (2, 20)

statement ok
ALTER TABLE dl.p ADD COLUMN c INTEGER

statement ok
INSERT INTO dl.p VALUES (3, 30, 300)

# the row of q is at a schema version whose snapshots are expired below
statement ok
CREATE TABLE dl.q (a INTEGER)

statement ok
ALTER TABLE dl.q ADD COLUMN b VARCHAR

statement ok
ALTER TABLE dl.q ADD COLUMN d DATE

statement ok
INSERT INTO dl.q VALUES (1, 'text', DATE '2026-01-02')

statement ok
ALTER TABLE dl.q ADD COLUMN c INTEGER

# the schema version of the creation of f has no begin below
statement ok
CREATE TABLE dl.f (a INTEGER)

statement ok
ALTER TABLE dl.f ADD COLUMN b INTEGER

statement ok
INSERT INTO dl.f VALUES (1, 10)

statement ok
ALTER TABLE dl.f ADD COLUMN c INTEGER

# g is like f, and its inlined table has a column that no table of g has
statement ok
CREATE TABLE dl.g (a INTEGER)

statement ok
ALTER TABLE dl.g ADD COLUMN b INTEGER

statement ok
INSERT INTO dl.g VALUES (1, 10)

statement ok
ALTER TABLE dl.g ADD COLUMN c INTEGER

statement ok
ALTER TABLE __ducklake_metadata_dl.ducklake_inlined_data_4_12 RENAME COLUMN b TO other

query III
SELECT table_id, begin_snapshot, schema_version FROM __ducklake_metadata_dl.ducklake_schema_versions ORDER BY ALL
----
1	1	1
1	3	2
1	5	3
2	7	4
2	8	5
2	9	6
2	11	7
3	12	8
3	13	9
3	15	10
4	16	11
4	17	12
4	19	13

# the migration of DuckDB 1.5.1 gave every schema version of a table the begin of its creation
statement ok
UPDATE __ducklake_metadata_dl.ducklake_schema_versions SET begin_snapshot = 1 WHERE table_id = 1

statement ok
UPDATE __ducklake_metadata_dl.ducklake_schema_versions SET begin_snapshot = 7 WHERE table_id = 2

statement ok
UPDATE __ducklake_metadata_dl.ducklake_schema_versions SET begin_snapshot = 12 WHERE table_id = 3

statement ok
UPDATE __ducklake_metadata_dl.ducklake_schema_versions SET begin_snapshot = 16 WHERE table_id = 4

# an older release left no row for a creation whose snapshot was expired before
statement ok
DELETE FROM __ducklake_metadata_dl.ducklake_schema_versions WHERE schema_version IN (8, 11)

statement ok
CALL ducklake_expire_snapshots('dl', older_than => now())

statement ok
DETACH dl

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl
	(DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', DATA_INLINING_ROW_LIMIT 10)

# the second row of p was written for the b that the table has now
query III
SELECT a, b, c FROM dl.p ORDER BY a
----
1	NULL	NULL
2	20	NULL
3	30	300

query III
SELECT a, b, d FROM dl.q
----
1	text	2026-01-02

query II
SELECT a, b FROM dl.f
----
1	10

# the row of g is read with the table at that begin, which a flush does not write it with
query I
SELECT a FROM dl.g
----
1

statement error
CALL ducklake_flush_inlined_data('dl', table_name => 'g')
----
the columns of its rows cannot be told

# rows that the transaction deleted are not flushed, so they do not refuse it
statement ok
BEGIN

statement ok
DELETE FROM dl.g

statement ok
CALL ducklake_flush_inlined_data('dl', table_name => 'g')

statement ok
ROLLBACK

foreach flushed p q f

statement ok
CALL ducklake_flush_inlined_data('dl', table_name => '{flushed}')

endloop

query III
SELECT a, b, c FROM dl.p ORDER BY a
----
1	NULL	NULL
2	20	NULL
3	30	300

query IIII
SELECT a, b, d, c FROM dl.q
----
1	text	2026-01-02	NULL

query III
SELECT a, b, c FROM dl.f
----
1	10	NULL

query I
SELECT other FROM __ducklake_metadata_dl.ducklake_inlined_data_4_12
----
10
