# name: test/sql/data_inlining/data_inlining_variant_decimal_width_sqlite.test
# description: The declared decimal types of an inlined VARIANT follow its Parquet Variant bytes, which older clients read as before
# group: [data_inlining]

require ducklake

require parquet

require sqlite_scanner

test-env DUCKLAKE_CONNECTION sqlite:{TEST_DIR}/variant_decimal_width.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS lk (DATA_PATH '{DATA_PATH}/variant_decimal_width', METADATA_CATALOG 'lk_meta', DATA_INLINING_ROW_LIMIT 100)

statement ok
CREATE TABLE lk.w (id INTEGER, v VARIANT)

statement ok
INSERT INTO lk.w VALUES
	(1, 1.5::DECIMAL(5,2)::VARIANT),
	(2, {'b': [1::DECIMAL(3,1)::VARIANT, {'c': -7.25::DECIMAL(12,4)}::VARIANT], 'a': 'x', 'z': 2::DECIMAL(2,0)}::VARIANT),
	(3, 42::VARIANT),
	(4, 'decimal'::VARIANT),
	(5, 7::DECIMAL(18,9)::VARIANT)

# the Parquet Variant bytes end with a format byte and a (width, scale) pair per decimal, values without decimals have
# none, and a decimal after rows without one keeps its types
query II
SELECT id, hex(v) FROM lk_meta.ducklake_inlined_data_1_1 WHERE id IN (1, 3, 4, 5) ORDER BY id
----
1	010000200296000000010502
3	010000142A000000
4	0100001D646563696D616C
5	010000240900863BA101000000011209

query I
SELECT hex(v[-7:]) FROM lk_meta.ducklake_inlined_data_1_1 WHERE id = 2
----
0103010C040200

# a client that reads the Parquet Variant alone gets the values with the width of their digits
query III
SELECT id, variant_bytes_to_variant(v)::VARCHAR, variant_typeof(variant_bytes_to_variant(v)) FROM lk_meta.ducklake_inlined_data_1_1 ORDER BY id
----
1	1.50	DECIMAL(3, 2)
2	{'a': x, 'b': [1.0, {'c': -7.2500}], 'z': 2}	OBJECT(a, b, z)
3	42	INT32
4	decimal	VARCHAR
5	7.000000000	DECIMAL(10, 9)

query III
SELECT id, v, variant_typeof(v) FROM lk.w ORDER BY id
----
1	1.50	DECIMAL(5, 2)
2	{'a': x, 'b': [1.0, {'c': -7.2500}], 'z': 2}	OBJECT(a, b, z)
3	42	INT32
4	decimal	VARCHAR
5	7.000000000	DECIMAL(18, 9)

# rows written without the types read as before
statement ok
UPDATE lk_meta.ducklake_inlined_data_1_1 SET v = v[1:-4] WHERE id = 1

query II
SELECT v, variant_typeof(v) FROM lk.w WHERE id = 1
----
1.50	DECIMAL(3, 2)

# types that do not fit the bytes are refused
statement ok
UPDATE lk_meta.ducklake_inlined_data_1_1 SET v = v || '\x01\x05'::BLOB WHERE id = 1

statement error
SELECT v FROM lk.w WHERE id = 1
----
unknown decimal types format

statement ok
UPDATE lk_meta.ducklake_inlined_data_1_1 SET v = v[1:-3] || '\x01\x05\x03'::BLOB WHERE id = 1

statement error
SELECT v FROM lk.w WHERE id = 1
----
does not hold DECIMAL(3, 2)

statement ok
UPDATE lk_meta.ducklake_inlined_data_1_1 SET v = v[1:-4] || '\x01\x05\x02\x05\x02'::BLOB WHERE id = 1

statement error
SELECT v FROM lk.w WHERE id = 1
----
declares 2 decimal types for 1 decimals

statement ok
UPDATE lk_meta.ducklake_inlined_data_1_1 SET v = v[1:-6] || '\x01\x05\x02'::BLOB WHERE id = 1

query II
SELECT v, variant_typeof(v) FROM lk.w WHERE id = 1
----
1.50	DECIMAL(5, 2)

# a width the value does not fit
statement ok
UPDATE lk_meta.ducklake_inlined_data_1_1 SET v = v[1:-4] || '\x01\x02\x02'::BLOB WHERE id = 1

statement error
SELECT v FROM lk.w WHERE id = 1
----
does not hold DECIMAL(3, 2)

# bytes whose metadata runs past their end
statement ok
UPDATE lk_meta.ducklake_inlined_data_1_1 SET v = from_hex('C100000000FFFFFFFF') WHERE id = 1

statement error
SELECT v FROM lk.w WHERE id = 1
----
no value follows the metadata
