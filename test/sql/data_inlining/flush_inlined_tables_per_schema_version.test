# name: test/sql/data_inlining/flush_inlined_tables_per_schema_version.test
# description: flushing inlined rows of tables created in separate snapshots loads only their own table per old schema version
# group: [data_inlining]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS lake (DATA_PATH '{DATA_PATH}/flush_inlined_tables_per_schema_version', DATA_INLINING_ROW_LIMIT 10)

# every table gets its own schema version, and t1 changes once more after its rows were inlined
loop i 1 7

statement ok
CREATE TABLE lake.t${i}(a INT, b VARCHAR)

statement ok
INSERT INTO lake.t${i} VALUES (${i}, 'x'), (${i} * 10, 'y')

endloop

# v1 and v2 share one schema version, which created two tables
statement ok
BEGIN

statement ok
CREATE TABLE lake.v1(a INT)

statement ok
CREATE TABLE lake.v2(a INT)

statement ok
COMMIT

statement ok
INSERT INTO lake.v1 VALUES (6)

statement ok
INSERT INTO lake.v2 VALUES (7)

# u1 to u4 share one schema version, which created four tables
statement ok
BEGIN

statement ok
CREATE TABLE lake.u1(a INT)

statement ok
CREATE TABLE lake.u2(a INT)

statement ok
CREATE TABLE lake.u3(a INT)

statement ok
CREATE TABLE lake.u4(a INT)

statement ok
COMMIT

statement ok
INSERT INTO lake.u1 VALUES (1), (2)

statement ok
INSERT INTO lake.u2 VALUES (3)

statement ok
INSERT INTO lake.u3 VALUES (4)

statement ok
INSERT INTO lake.u4 VALUES (5)

statement ok
ALTER TABLE lake.t1 ADD COLUMN c INT

statement ok
INSERT INTO lake.t1 VALUES (100, 'z', 7)

# attach again so that no catalog of an old schema version is cached
statement ok
DETACH lake

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS lake (DATA_PATH '{DATA_PATH}/flush_inlined_tables_per_schema_version', DATA_INLINING_ROW_LIMIT 10)

statement ok
CALL enable_logging('DuckLakeMetadata')

query TI
SELECT table_name, rows_flushed FROM ducklake_flush_inlined_data('lake') ORDER BY ALL
----
t1	3
t2	2
t3	2
t4	2
t5	2
t6	2
u1	2
u2	1
u3	1
u4	1
v1	1
v2	1

# the flush loads the tables it needs of an old schema version together, t1 to t6 alone, v1 and v2 in one load and
# u1 to u4 in one load, the whole catalog is loaded for the current version only
query III
SELECT count(*) FILTER (WHERE query NOT LIKE '%tbl.table_id IN (%'),
	count(*) FILTER (WHERE query LIKE '%tbl.table_id IN (%'),
	count(*) FILTER (WHERE regexp_matches(query, 'tbl\.table_id IN \(\d+, \d+'))
FROM duckdb_logs_parsed('DuckLakeMetadata')
WHERE query LIKE '%ducklake_table tbl%'
----
1	8	2

statement ok
CALL disable_logging()

query III
SELECT * FROM lake.t1 ORDER BY a
----
1	x	NULL
10	y	NULL
100	z	7

query II
SELECT * FROM lake.t6 ORDER BY a
----
6	x
60	y

query I
SELECT count(*) FROM ducklake_list_files('lake', 't1')
----
2

# a table read alone at a version that created four tables loads the whole catalog of that version
statement ok
DETACH lake

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS lake (DATA_PATH '{DATA_PATH}/flush_inlined_tables_per_schema_version', DATA_INLINING_ROW_LIMIT 10)

statement ok
CALL truncate_duckdb_logs()

statement ok
CALL enable_logging('DuckLakeMetadata')

statement ok
INSERT INTO lake.u1 VALUES (9)

query I
SELECT * FROM lake.u1 ORDER BY a
----
1
2
9

query II
SELECT count(*) FILTER (WHERE query NOT LIKE '%tbl.table_id IN (%'),
	count(*) FILTER (WHERE query LIKE '%tbl.table_id IN (%')
FROM duckdb_logs_parsed('DuckLakeMetadata')
WHERE query LIKE '%ducklake_table tbl%'
----
2	0

statement ok
CALL disable_logging()

# new inlined rows of a table of an old schema version flush and read back
statement ok
INSERT INTO lake.t3 VALUES (300, 'w')

query TI
SELECT table_name, rows_flushed FROM ducklake_flush_inlined_data('lake', table_name => 't3')
----
t3	1

query I
SELECT count(*) FROM lake.t3
----
3

query I
SELECT count(*) FROM ducklake_list_files('lake', 't3')
----
2
