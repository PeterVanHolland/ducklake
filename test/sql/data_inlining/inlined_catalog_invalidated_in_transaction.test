# name: test/sql/data_inlining/inlined_catalog_invalidated_in_transaction.test
# description: A transaction reloads the catalog it uses after another connection invalidates it
# group: [data_inlining]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS lake (DATA_PATH '{DATA_PATH}/inlined_catalog_invalidated_in_transaction', DATA_INLINING_ROW_LIMIT 10)

statement ok
CREATE TABLE lake.u(a INT)

statement ok
INSERT INTO lake.u VALUES (1), (2)

# a transaction reads u, then another connection flushes and alters u, which invalidates the cached catalogs
statement ok con1
BEGIN

query I con1
SELECT sum(a) FROM lake.u
----
3

statement ok con2
SELECT count(*) FROM ducklake_flush_inlined_data('lake', table_name => 'u')

statement ok con2
ALTER TABLE lake.u ADD COLUMN b INT

statement ok con1
CALL enable_logging('DuckLakeMetadata')

query I con1
SELECT sum(a) FROM lake.u
----
3

statement ok con1
CALL disable_logging()

# the invalidated catalog is loaded again
query I con1
SELECT count(*) FROM duckdb_logs_parsed('DuckLakeMetadata')
WHERE query LIKE '%ducklake_table tbl%' AND query NOT LIKE '%tbl.table_id =%'
----
1

statement ok con1
COMMIT

query II
SELECT a, b FROM lake.u ORDER BY a
----
1	NULL
2	NULL

# a transaction alters u while another connection commits a schema change, which invalidates the catalog the
# altered entry was made from
statement ok con1
BEGIN

statement ok con1
ALTER TABLE lake.u ADD COLUMN c INT

statement ok con2
CREATE TABLE lake.x(i INT)

query III con1
SELECT a, b, c FROM lake.u ORDER BY a
----
1	NULL	NULL
2	NULL	NULL

statement ok con1
COMMIT

query III
SELECT a, b, c FROM lake.u ORDER BY a
----
1	NULL	NULL
2	NULL	NULL
