# name: test/sql/data_inlining/inlined_catalog_invalidated_in_transaction.test
# description: A transaction reloads the catalog it uses after another connection invalidates it
# group: [data_inlining]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS lake (DATA_PATH '{DATA_PATH}/inlined_catalog_invalidated_in_transaction', DATA_INLINING_ROW_LIMIT 10)

statement ok
CREATE TABLE lake.u(a INT)

statement ok
INSERT INTO lake.u VALUES (1), (2)

# a transaction reads u, then another connection flushes and alters u, which invalidates the cached catalogs
statement ok con1
BEGIN

query I con1
SELECT sum(a) FROM lake.u
----
3

statement ok con2
SELECT count(*) FROM ducklake_flush_inlined_data('lake', table_name => 'u')

statement ok con2
ALTER TABLE lake.u ADD COLUMN b INT

query I con1
SELECT sum(a) FROM lake.u
----
3

statement ok con1
COMMIT

query II
SELECT a, b FROM lake.u ORDER BY a
----
1	NULL
2	NULL
