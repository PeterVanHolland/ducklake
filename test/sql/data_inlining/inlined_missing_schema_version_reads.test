# name: test/sql/data_inlining/inlined_missing_schema_version_reads.test
# description: Inlined data whose schema version has no row is read at one snapshot of the version, with no catalog load
# group: [data_inlining]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE dl.other (i INTEGER)

statement ok
CREATE TABLE dl.t (id INTEGER, s VARCHAR)

# the first inlined rows of t register its inlined data table at a schema version of their own
statement ok
CALL dl.set_option('data_inlining_row_limit', 10, table_name => 't')

statement ok
INSERT INTO dl.t VALUES (1, NULL)

query I
SELECT count(*) FROM meta.ducklake_inlined_data_tables idt JOIN meta.ducklake_schema_versions sv
ON sv.table_id = idt.table_id AND sv.schema_version = idt.schema_version
----
0

# loads the catalog of the current schema version
statement ok
SELECT * FROM dl.other

statement ok
CALL enable_logging('DuckLakeMetadata')

query II
SELECT * FROM dl.t
----
1	NULL

statement ok
CALL disable_logging()

# the read looks for the row of the version, then for one snapshot of the version, and loads no catalog
query III
SELECT count(*) FILTER (WHERE regexp_matches(query, 'schema_version = \d+')),
       count(*) FILTER (WHERE regexp_matches(query, 'ducklake_snapshot WHERE schema_version = \d+ LIMIT 1')),
       count(*) FILTER (WHERE query LIKE '%ducklake_macro%')
FROM duckdb_logs_parsed('DuckLakeMetadata')
----
2	1	0

statement ok
CALL truncate_duckdb_logs()

statement ok
CALL enable_logging('DuckLakeMetadata')

# the first value of a column that is NULL in every row reads the columns of the inlined data
statement ok
INSERT INTO dl.t VALUES (2, 'v')

statement ok
CALL disable_logging()

query II
SELECT count(*) FILTER (WHERE regexp_matches(query, 'ducklake_column col ON col\.table_id = inlined\.table_id')),
       count(*) FILTER (WHERE regexp_matches(query, 'schema_version = \d+'))
FROM duckdb_logs_parsed('DuckLakeMetadata')
----
1	1

query II
SELECT * FROM dl.t ORDER BY id
----
1	NULL
2	v
