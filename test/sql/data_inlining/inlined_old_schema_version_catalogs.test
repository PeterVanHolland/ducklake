# name: test/sql/data_inlining/inlined_old_schema_version_catalogs.test
# description: Catalogs of old schema versions are reused across reads and reloaded after another commit invalidates them
# group: [data_inlining]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/inlined_old_schema_version_catalogs.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS lake (DATA_PATH '{DATA_PATH}/inlined_old_schema_version_catalogs', DATA_INLINING_ROW_LIMIT 10)

statement ok
CREATE TABLE lake.t(a INT)

statement ok
INSERT INTO lake.t VALUES (1), (2)

# the rows of t stay inlined at the schema version before this one
statement ok
ALTER TABLE lake.t ADD COLUMN b INT

statement ok
INSERT INTO lake.t VALUES (3, 30)

statement ok
DETACH lake

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS lake (DATA_PATH '{DATA_PATH}/inlined_old_schema_version_catalogs')

statement ok
CALL enable_logging('DuckLakeMetadata')

loop i 0 3

query I
SELECT sum(a) FROM lake.t
----
6

endloop

statement ok
CALL disable_logging()

# the catalogs of the current and the old schema version are each loaded once for the three reads
query I
SELECT count(*) FROM duckdb_logs_parsed('DuckLakeMetadata') WHERE query LIKE '%ducklake_table tbl%'
----
2

statement ok
CREATE TABLE lake.u(a INT)

statement ok
INSERT INTO lake.u VALUES (1), (2)

# a transaction reads u, then another connection flushes its rows and alters it, which drops the inlined table it
# emptied and invalidates the cached catalogs
statement ok con1
BEGIN

query I con1
SELECT sum(a) FROM lake.u
----
3

statement ok con2
SELECT count(*) FROM ducklake_flush_inlined_data('lake', table_name => 'u')

statement ok con2
ALTER TABLE lake.u ADD COLUMN b INT

query I con1
SELECT sum(a) FROM lake.u
----
3

statement ok con1
COMMIT

query II
SELECT a, b FROM lake.u ORDER BY a
----
1	NULL
2	NULL
