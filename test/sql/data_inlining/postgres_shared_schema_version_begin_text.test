# name: test/sql/data_inlining/postgres_shared_schema_version_begin_text.test
# description: an inlined table that kept the text columns of DuckLake 0.3 is read without decoding them
# group: [data_inlining]

require ducklake

require parquet

require postgres_scanner

require-env DUCKLAKE_CI

require-env DUCKLAKE_CONNECTION

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl
	(DATA_PATH '{DATA_PATH}/postgres_shared_begin_text', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE dl.t (a INTEGER)

statement ok
CALL dl.set_option('data_inlining_row_limit', 10, table_name => 't')

statement ok
ALTER TABLE dl.t ADD COLUMN b VARCHAR

statement ok
INSERT INTO dl.t VALUES (1, 'text')

statement ok
ALTER TABLE dl.t ADD COLUMN c INTEGER

# DuckLake 0.3 stored text as text, and its type migration skipped the inlined tables of such schema versions
statement ok
CALL postgres_execute('__ducklake_metadata_dl',
	'ALTER TABLE ducklake_inlined_data_1_2 ALTER COLUMN b TYPE VARCHAR USING convert_from(b, ''UTF8'')')

# the rows of test/sql/migration/migrated_inlined_schema_version.test
statement ok
UPDATE __ducklake_metadata_dl.ducklake_schema_versions SET begin_snapshot = 1 WHERE schema_version IN (2, 3)

statement ok
DETACH dl

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl
	(DATA_PATH '{DATA_PATH}/postgres_shared_begin_text', DATA_INLINING_ROW_LIMIT 0)

# a read of b would decode text, so the table is read as it was created
query I
SELECT a FROM dl.t
----
1

statement ok
SELECT * FROM dl.t
