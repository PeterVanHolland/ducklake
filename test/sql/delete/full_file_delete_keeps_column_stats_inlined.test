# name: test/sql/delete/full_file_delete_keeps_column_stats_inlined.test
# description: a delete that drops a data file and deletes inlined rows keeps the table's column stats
# group: [delete]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

# the default inlining limit: the second insert is inlined
statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS lake (DATA_PATH '{DATA_PATH}/full_file_delete_keeps_column_stats_inlined')

statement ok
CREATE TABLE lake.t (id BIGINT, v VARCHAR)

statement ok
INSERT INTO lake.t SELECT i, 'a' || i FROM range(100) r(i)

statement ok
INSERT INTO lake.t VALUES (1000, 'b')

statement ok
SET VARIABLE t_id = (SELECT table_id FROM __ducklake_metadata_lake.ducklake_table WHERE table_name = 't' AND end_snapshot IS NULL)

query II
SELECT (SELECT count(*) FROM __ducklake_metadata_lake.ducklake_data_file WHERE table_id = getvariable('t_id') AND end_snapshot IS NULL), (SELECT count(*) FROM __ducklake_metadata_lake.ducklake_table_column_stats WHERE table_id = getvariable('t_id'))
----
1	2

# the delete drops the file and deletes the inlined row: the column stats rows stay, with unknown bounds
query I
DELETE FROM lake.t
----
101

query III
SELECT column_id, min_value IS NULL, max_value IS NULL FROM __ducklake_metadata_lake.ducklake_table_column_stats WHERE table_id = getvariable('t_id') ORDER BY column_id
----
1	true	true
2	true	true

query I
SELECT count(*) FROM lake.t
----
0

statement ok
INSERT INTO lake.t VALUES (5, 'x'), (7, 'y')

query III
SELECT count(*), min(id), max(id) FROM lake.t
----
2	5	7

query I
SELECT count(*) FROM __ducklake_metadata_lake.ducklake_table_column_stats WHERE table_id = getvariable('t_id')
----
2
