# name: test/sql/delete/full_file_delete_keeps_column_stats_older_reader.test
# description: a reader whose snapshot predates a delete that dropped a data file keeps the bounds of its snapshot
# group: [delete]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS lake (DATA_PATH '{DATA_PATH}/full_file_delete_keeps_column_stats_older_reader', DATA_INLINING_ROW_LIMIT 0)

# a reader whose snapshot predates the drop must not prune with the narrowed bounds another connection cached
statement ok
CREATE TABLE lake.c (id BIGINT)

statement ok
INSERT INTO lake.c SELECT i FROM range(100) r(i)

statement ok
INSERT INTO lake.c SELECT i FROM range(1000, 1050) r(i)

statement ok con1
BEGIN

query I con1
SELECT count(*) FROM lake.c
----
150

query I
DELETE FROM lake.c WHERE id >= 1000
----
50

query II
SELECT count(*), max(id) FROM lake.c
----
100	99

query I con1
SELECT count(*) FROM lake.c WHERE id >= 1000
----
50

query II con1
SELECT count(*), max(id) FROM lake.c
----
150	1049

statement ok con1
COMMIT

query II
SELECT count(*), max(id) FROM lake.c
----
100	99
