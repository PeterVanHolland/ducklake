# name: test/sql/delete/several_delete_files_removed.test
# description: The change feed of a data file that ends with several visible delete files lists its live rows only
# group: [delete]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS lake
	(DATA_PATH '{DATA_PATH}/several_delete_files_removed', DATA_INLINING_ROW_LIMIT 10)

# both tables get two data files, and then a delete file for each of them
foreach tbl t u

statement ok
CREATE TABLE lake.{tbl} (id INTEGER, v INTEGER)

statement ok
INSERT INTO lake.{tbl} SELECT i, i FROM range(200) t(i)

statement ok
INSERT INTO lake.{tbl} SELECT i, i FROM range(1000, 1200) t(i)

endloop

foreach tbl t u

statement ok
DELETE FROM lake.{tbl} WHERE id < 20

statement ok
DELETE FROM lake.{tbl} WHERE id >= 1100

endloop

# an older release could leave a data file with two live delete files, here the delete file of the second data file
# of each table becomes one of the first
statement ok
UPDATE __ducklake_metadata_lake.ducklake_delete_file SET data_file_id = data_file_id - 1 WHERE data_file_id IN (1, 3)

query II
SELECT (SELECT count(*) FROM lake.t WHERE id < 1000), (SELECT count(*) FROM lake.u WHERE id < 1000)
----
80	80

# the data file is listed once for each of its delete files
query III
SELECT count(*), count(DISTINCT data_file), count(DISTINCT delete_file) FROM ducklake_list_files('lake', 't')
----
3	2	2

statement ok
SET VARIABLE removed_file =
	(SELECT data_file FROM ducklake_list_files('lake', 't') WHERE delete_file IS NOT NULL LIMIT 1)

statement ok
CALL ducklake_remove_data_files('lake', 't', [getvariable('removed_file')])

query I
SELECT count(*) FROM lake.t
----
200

# the rows that the two delete files had deleted before are not deleted again
query IIII
SELECT change_type, count(*), min(id), max(id) FROM ducklake_table_changes('lake', 'main', 't', 11, 11) GROUP BY ALL
----
delete	80	20	99

query II
SELECT count(*), count(DISTINCT id) FROM ducklake_table_deletions('lake', 'main', 't', 7, 11)
----
200	200

# a delete of every row ends the data files
statement ok
DELETE FROM lake.u

query IIII
SELECT change_type, count(*), min(id), max(id) FROM ducklake_table_changes('lake', 'main', 'u', 12, 12) GROUP BY ALL
----
delete	280	20	1199

query II
SELECT count(*), count(DISTINCT id) FROM ducklake_table_deletions('lake', 'main', 'u', 9, 12)
----
400	400
