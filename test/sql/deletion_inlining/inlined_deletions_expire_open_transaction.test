# name: test/sql/deletion_inlining/inlined_deletions_expire_open_transaction.test
# description: an expiry removes the inlined deletions of a file that was replaced after its transaction began
# group: [deletion_inlining]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (
	DATA_PATH '{DATA_PATH}/inlined_deletions_expire_open_files',
	METADATA_CATALOG 'ducklake_meta',
	DATA_INLINING_ROW_LIMIT 10
)

statement ok
CREATE TABLE ducklake.t AS SELECT range AS i FROM range(100)

# the transaction reads the table before its inlined deletion table exists
statement ok con1
BEGIN

query I con1
SELECT sum(i) FROM ducklake.t
----
4950

statement ok
DELETE FROM ducklake.t WHERE i = 5

statement ok
CALL ducklake_rewrite_data_files('ducklake', 't', delete_threshold => 0)

statement ok
INSERT INTO ducklake.t SELECT range AS i FROM range(100, 200)

# a commit with a tag checks for conflicts first, so it is not retried at a newer snapshot
statement ok con1
CALL ducklake_create_tag('ducklake', 'first', version => 0)

statement ok con1
CALL ducklake_expire_snapshots('ducklake', older_than => TIMESTAMPTZ '2999-01-01')

statement ok con1
COMMIT

# the replaced file is gone, and its inlined deletion with it
query I
SELECT count(*) FROM ducklake_meta.ducklake_data_file
----
2

query I
SELECT count(*) FROM ducklake_meta.ducklake_inlined_delete_1
----
0

query II
SELECT count(*), count(*) FILTER (WHERE i = 5) FROM ducklake.t
----
199	0
