# name: test/sql/metadata/two_live_table_rows.test
# description: a table with two live rows, as some releases left it after a rename, loads as its newest row
# group: [metadata]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files')

statement ok
CREATE TABLE dl.t (i INTEGER, j INTEGER)

statement ok
INSERT INTO dl.t VALUES (1, 10)

statement ok
CREATE TABLE dl.u AS SELECT 7 AS x

statement ok
CREATE TABLE dl.w AS SELECT 5 AS y

statement ok
INSERT INTO dl.w VALUES (6)

# as DuckDB 1.5.6 leaves a table that is changed and renamed in one transaction
statement ok
INSERT INTO __ducklake_metadata_dl.ducklake_table
SELECT * REPLACE ('t2' AS table_name, 3 AS begin_snapshot)
FROM __ducklake_metadata_dl.ducklake_table WHERE table_name = 't'

# the same with the older row stored after the newer one
statement ok
INSERT INTO __ducklake_metadata_dl.ducklake_table
SELECT * REPLACE ('w2' AS table_name, 5 AS begin_snapshot)
FROM __ducklake_metadata_dl.ducklake_table WHERE table_name = 'w'

statement ok
CREATE TEMP TABLE older_row AS SELECT * FROM __ducklake_metadata_dl.ducklake_table WHERE table_name = 'w'

statement ok
DELETE FROM __ducklake_metadata_dl.ducklake_table WHERE table_name = 'w'

statement ok
INSERT INTO __ducklake_metadata_dl.ducklake_table SELECT * FROM older_row

statement ok
DETACH dl

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files')

query I
SELECT * FROM dl.u
----
7

query II
SELECT * FROM dl.t2
----
1	10

statement error
SELECT * FROM dl.t
----
Table with name t does not exist

query I
SELECT * FROM dl.w2 ORDER BY ALL
----
5
6

statement error
SELECT * FROM dl.w
----
Table with name w does not exist

query II
SELECT * FROM dl.t AT (VERSION => 2)
----
1	10

statement ok
INSERT INTO dl.t2 VALUES (2, 20)

statement ok
ALTER TABLE dl.t2 RENAME TO t3

query II
SELECT * FROM dl.t3 ORDER BY ALL
----
1	10
2	20

statement ok
DROP TABLE dl.t3

query I
SELECT table_name FROM duckdb_tables() WHERE database_name = 'dl' ORDER BY ALL
----
u
w2
