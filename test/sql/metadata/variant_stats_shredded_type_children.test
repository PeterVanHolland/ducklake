# name: test/sql/metadata/variant_stats_shredded_type_children.test
# description: invalid stored VARIANT statistics report an error when the column is read and are dropped by the next append
# group: [metadata]

require ducklake

require parquet

test-env DATA_PATH {TEST_DIR}

foreach nested_type list struct map

statement ok
ATTACH 'ducklake:{TEST_DIR}/shredded_${nested_type}.db' AS dl (DATA_PATH '{DATA_PATH}/shredded_${nested_type}', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE dl.t AS SELECT 1::VARIANT AS v

statement ok
CREATE TABLE dl.healthy AS SELECT 2::VARIANT AS w

query I
SELECT stats(v) IS NOT NULL FROM dl.t
----
true

statement ok
UPDATE __ducklake_metadata_dl.ducklake_table_column_stats SET extra_stats = '[{"field_name":"\"a\"","shredded_type":"int32","min":"1","max":"1"},{"field_name":"\"b\"","shredded_type":"${nested_type}"}]' WHERE table_id = (SELECT table_id FROM __ducklake_metadata_dl.ducklake_table WHERE table_name = 't')

statement ok
DETACH dl

statement ok
ATTACH 'ducklake:{TEST_DIR}/shredded_${nested_type}.db' AS dl

# the other table loads, and a count needs no column statistics
query I
SELECT stats(w) IS NOT NULL FROM dl.healthy
----
true

query I
SELECT count(*) FROM dl.t
----
1

# reading the column asks for its statistics
statement error
SELECT stats(v) FROM dl.t
----
<REGEX>:.*Invalid Input Error.*Column "v".*shredded type "(list|struct|map)".*

statement error
SELECT v FROM dl.t
----
<REGEX>:.*Invalid Input Error.*Column "v" has invalid stored statistics.*

# an append restores the column reads and drops the stored statistics, the valid field with them
statement ok
INSERT INTO dl.t VALUES (4::VARIANT)

query I
SELECT count(*) FROM dl.t WHERE v IS NOT NULL
----
2

query I
SELECT DISTINCT stats(v) IS NOT NULL FROM dl.t
----
true

statement ok
DETACH dl

statement ok
ATTACH 'ducklake:{TEST_DIR}/shredded_${nested_type}.db' AS dl

query I
SELECT count(*) FROM dl.t WHERE v IS NOT NULL
----
2

query I
SELECT extra_stats IS NULL FROM __ducklake_metadata_dl.ducklake_table_column_stats WHERE table_id = (SELECT table_id FROM __ducklake_metadata_dl.ducklake_table WHERE table_name = 't')
----
true

statement ok
DETACH dl

endloop

# other invalid statistics are reported the same way
foreach payload [{"field_name":"root","shredded_type":"int3"}] [{"field_name":"root","shredded_type":"decimal"}] [{"field_name":"root","shredded_type":"decimal(foo,2)"}] [{"field_name":"root","shredded_type":"decimal(8)"}] [{"field_name":"root","shredded_type":"decimal(264,2)"}] [{"field_name":"root","shredded_type":"decimal(8junk,2)"}] [{"field_name":"root","shredded_type":"decimal(2,8)"}] [{"field_name":"root","shredded_type":"decimal(0x8,2)"}] [{"field_name":"root","shredded_type":"decimal(8,2,)"}] [{"field_name":"root","shredded_type":"int32","min":[1]}] [{"field_name":"root","shredded_type":"int32","null_count":-1}] [{"field_name":"root","shredded_type":"int32","num_values":1.5}] [{"field_name":"root","shredded_type":"int32","contains_nan":"true"}] [{"field_name":"root","shredded_type":"int32"},{"field_name":"\"x\"","shredded_type":"int32"}] [{"field_name":"element","shredded_type":"int32"},{"field_name":"\"x\"","shredded_type":"int32"}] [{"field_name":"root","shredded_type":"int32","null_count":2,"num_values":1}] [{"field_name":"root","shredded_type":"int32"},{"field_name":"root","shredded_type":"int32"}] [{"field_name":"element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element.element","shredded_type":"int32"}] {} [1] [{"field_name":["x"],"shredded_type":"int32"}] notjson

statement ok
ATTACH 'ducklake:{TEST_DIR}/shredded_other.db' AS dl (DATA_PATH '{DATA_PATH}/shredded_other', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE IF NOT EXISTS dl.t AS SELECT 1::VARIANT AS v

statement ok
UPDATE __ducklake_metadata_dl.ducklake_table_column_stats SET extra_stats = '${payload}'

statement ok
DETACH dl

statement ok
ATTACH 'ducklake:{TEST_DIR}/shredded_other.db' AS dl

statement error
SELECT stats(v) FROM dl.t
----
<REGEX>:.*Invalid Input Error.*Column "v" has invalid stored statistics.*

statement ok
DETACH dl

endloop

# bounds that do not parse give unknown statistics, not empty ones
statement ok
ATTACH 'ducklake:{TEST_DIR}/shredded_other.db' AS dl

statement ok
UPDATE __ducklake_metadata_dl.ducklake_table_column_stats SET extra_stats = '[{"field_name":"root","shredded_type":"int32","min":"bad","max":"bad"}]'

statement ok
DETACH dl

statement ok
ATTACH 'ducklake:{TEST_DIR}/shredded_other.db' AS dl

query I
SELECT count(*) FROM dl.t WHERE v::INTEGER = 1
----
1

query I
SELECT DISTINCT stats(v) IS NOT NULL FROM dl.t
----
true

statement ok
DETACH dl

# a malformed DECIMAL column type is rejected when the catalog loads
statement ok
ATTACH 'ducklake:{TEST_DIR}/shredded_other.db' AS dl

statement ok
UPDATE __ducklake_metadata_dl.ducklake_column SET column_type = 'decimal(264,2)' WHERE column_name = 'v'

statement ok
DETACH dl

statement ok
ATTACH 'ducklake:{TEST_DIR}/shredded_other.db' AS dl

statement error
SELECT v FROM dl.t
----
<REGEX>:.*Invalid Input Error.*invalid DECIMAL width or scale in 'decimal\(264,2\)'.*

statement ok
DETACH dl
