# name: test/sql/metadata/view_load_error.test
# description: A failure to load the views of the catalog reports the view query
# group: [metadata]

require ducklake

require parquet

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{TEST_DIR}/view_load_error.db' AS lake (DATA_PATH '{DATA_PATH}/view_load_error')

statement ok
CREATE TABLE lake.t(i INTEGER)

statement ok
CREATE TABLE __ducklake_metadata_lake.main.ducklake_view_copy AS FROM __ducklake_metadata_lake.main.ducklake_view

statement ok
DROP TABLE __ducklake_metadata_lake.main.ducklake_view

statement ok
DETACH lake

statement ok
ATTACH 'ducklake:{TEST_DIR}/view_load_error.db' AS lake (DATA_PATH '{DATA_PATH}/view_load_error')

statement error
SELECT * FROM lake.t
----
Failed to list the tables and views of a schema in DuckLake

statement error
SELECT count(*) FROM duckdb_tables() WHERE database_name = 'lake'
----
Failed to get view information from DuckLake

# the failed lookups left nothing behind, the repaired catalog loads
statement ok
CREATE TABLE __ducklake_metadata_lake.main.ducklake_view AS FROM __ducklake_metadata_lake.main.ducklake_view_copy

query I
SELECT count(*) FROM lake.t
----
0

query I
SELECT count(*) FROM duckdb_tables() WHERE database_name = 'lake'
----
1
