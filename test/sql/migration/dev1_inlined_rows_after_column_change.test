# name: test/sql/migration/dev1_inlined_rows_after_column_change.test
# description: The migration of a dev catalog leaves inlined rows where they are, the catalog can have a later layout
# group: [migration]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/dev1_inlined_rows_after_column_change',
    DUCKLAKE_VERSION '1.1', DATA_INLINING_ROW_LIMIT 10)

statement ok
CREATE TABLE dl.s (a INTEGER, b INTEGER)

statement ok
INSERT INTO dl.s VALUES (1, 10), (5, 50)

statement ok
CALL dl.set_option('data_inlining_row_limit', 0)

statement ok
ALTER TABLE dl.s DROP COLUMN b

statement ok
ALTER TABLE dl.s ADD COLUMN b INTEGER

statement ok
CALL dl.set_option('data_inlining_row_limit', 10)

statement ok
CREATE TABLE dl.other (x INTEGER)

# a row after the column changes in the inlined table from before them, in a catalog marked as a dev catalog
statement ok
INSERT INTO __ducklake_metadata_dl.ducklake_inlined_data_1_1 VALUES (2, 5, NULL, 3, 30)

statement ok
UPDATE __ducklake_metadata_dl.ducklake_metadata SET value = '1.1-dev1' WHERE key = 'version'

statement ok
DETACH dl

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/dev1_inlined_rows_after_column_change', AUTOMATIC_MIGRATION TRUE, DATA_INLINING_ROW_LIMIT 10)

query II
SELECT * FROM dl.s ORDER BY a
----
1	NULL
3	NULL
5	NULL

query I
SELECT table_name FROM __ducklake_metadata_dl.ducklake_inlined_data_tables WHERE table_id = 1
----
ducklake_inlined_data_1_1
