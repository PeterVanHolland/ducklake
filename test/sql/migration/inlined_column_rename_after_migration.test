# name: test/sql/migration/inlined_column_rename_after_migration.test
# description: AUTOMATIC_MIGRATION renames the legacy inlined table of a table a v1.0 session created after the migration
# group: [migration]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/inlined_column_rename_after_migration.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/inlined_rename_after_files', METADATA_CATALOG 'dlmeta', DATA_INLINING_ROW_LIMIT 10, DUCKLAKE_VERSION '1.0')

statement ok
CREATE TABLE dl.t(i INTEGER);

statement ok
INSERT INTO dl.t VALUES (1);

statement ok
DETACH dl

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/inlined_rename_after_files', METADATA_CATALOG 'dlmeta', DATA_INLINING_ROW_LIMIT 10, AUTOMATIC_MIGRATION TRUE)

# a v1.1 table can have a user column with a v1.0 metadata column name
statement ok
CREATE TABLE dl.u(row_id INTEGER);

statement ok
INSERT INTO dl.u VALUES (3);

# a session that attached at v1.0 before the migration still creates tables with the v1.0 names
statement ok
UPDATE dlmeta.ducklake_metadata SET value = '1.0' WHERE key = 'version'

statement ok
DETACH dl

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/inlined_rename_after_files', METADATA_CATALOG 'dlmeta', DATA_INLINING_ROW_LIMIT 10, DUCKLAKE_VERSION '1.0')

statement ok
CREATE TABLE dl.e(i INTEGER);

statement ok
UPDATE dlmeta.ducklake_metadata SET value = '1.1' WHERE key = 'version'

statement ok
DETACH dl

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/inlined_rename_after_files', METADATA_CATALOG 'dlmeta', DATA_INLINING_ROW_LIMIT 10)

statement error
SELECT * FROM dl.e
----
reattach with AUTOMATIC_MIGRATION TRUE

statement ok
DETACH dl

# read-only attaches do not rename
statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/inlined_rename_after_files', METADATA_CATALOG 'dlmeta', DATA_INLINING_ROW_LIMIT 10, AUTOMATIC_MIGRATION TRUE, READ_ONLY)

statement error
SELECT * FROM dl.e
----
reattach with AUTOMATIC_MIGRATION TRUE

statement ok
DETACH dl

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/inlined_rename_after_files', METADATA_CATALOG 'dlmeta', DATA_INLINING_ROW_LIMIT 10, AUTOMATIC_MIGRATION TRUE, SNAPSHOT_VERSION 1)

statement ok
SELECT row_id FROM dlmeta.ducklake_inlined_data_3_3 LIMIT 0

statement ok
DETACH dl

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/inlined_rename_after_files', METADATA_CATALOG 'dlmeta', DATA_INLINING_ROW_LIMIT 10, AUTOMATIC_MIGRATION TRUE)

statement ok
INSERT INTO dl.e VALUES (2);

query I
SELECT * FROM dl.e
----
2

query I
SELECT * FROM dl.t
----
1

statement ok
CHECKPOINT dl

query I
SELECT * FROM dl.e
----
2

statement ok
DETACH dl

# a v1.0 session can create a column that collides with a renamed metadata column
statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/inlined_rename_after_files', METADATA_CATALOG 'dlmeta', DATA_INLINING_ROW_LIMIT 10)

statement ok
UPDATE dlmeta.ducklake_metadata SET value = '1.0' WHERE key = 'version'

statement ok
DETACH dl

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/inlined_rename_after_files', METADATA_CATALOG 'dlmeta', DATA_INLINING_ROW_LIMIT 10, DUCKLAKE_VERSION '1.0')

statement ok
CREATE TABLE dl.c(_ducklake_row_id INTEGER);

statement ok
UPDATE dlmeta.ducklake_metadata SET value = '1.1' WHERE key = 'version'

statement ok
DETACH dl

# the attach leaves that table alone
statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/inlined_rename_after_files', METADATA_CATALOG 'dlmeta', DATA_INLINING_ROW_LIMIT 10, AUTOMATIC_MIGRATION TRUE)

query III
SELECT (SELECT i FROM dl.t), (SELECT i FROM dl.e), (SELECT row_id FROM dl.u)
----
1	2	3

statement error
SELECT * FROM dl.c
----
reattach with AUTOMATIC_MIGRATION TRUE
