# name: test/sql/migration/migrated_inlined_missing_creation.test
# description: rows inlined at the first schema version that a table has left, which is not the one of its creation
# group: [migration]

require ducklake

require parquet

# written by DuckDB 1.3.2 with data inlining: t (a), b added, a row, then every snapshot but the last expired.
# DuckDB 1.4.4 filled the schema versions from the snapshots that were left, so the creation of t has none, and
# DuckDB 1.5.1 gave the others the begin of the creation
unzip data/old_ducklake/migrated_inlined_missing_creation.db.gz {TEST_DIR}/migrated_inlined_missing_creation.db

# the migration to 2.0 converts no inlined rows, a 1.1 catalog keeps them
statement ok
ATTACH 'ducklake:{TEST_DIR}/migrated_inlined_missing_creation.db' AS missing
	(DATA_PATH '{TEST_DIR}/migrated_inlined_missing_creation', OVERRIDE_DATA_PATH TRUE, DUCKLAKE_VERSION '1.1',
	AUTOMATIC_MIGRATION TRUE, DATA_INLINING_ROW_LIMIT 10)

query II
SELECT begin_snapshot, schema_version FROM __ducklake_metadata_missing.ducklake_schema_versions
WHERE table_id = 1 ORDER BY ALL
----
1	2
1	3

# the row was written for the table with b
query II
SELECT a, b FROM missing.t
----
1	10

statement ok
CALL ducklake_flush_inlined_data('missing')

query II
SELECT a, b FROM missing.t
----
1	10

query I
SELECT count(*) FROM ducklake_list_files('missing', 't')
----
1

# the flush wrote the inlined rows to files with their columns, the migration to 2.0 converts none
statement ok
DETACH missing

statement ok
ATTACH 'ducklake:{TEST_DIR}/migrated_inlined_missing_creation.db' AS missing
	(DATA_PATH '{TEST_DIR}/migrated_inlined_missing_creation', OVERRIDE_DATA_PATH TRUE, AUTOMATIC_MIGRATION TRUE)

query II
SELECT a, b FROM missing.t
----
1	10
