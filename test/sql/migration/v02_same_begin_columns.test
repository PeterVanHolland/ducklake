# name: test/sql/migration/v02_same_begin_columns.test
# description: a catalog of DuckDB 1.3 keeps the last written row of a column that one transaction changed twice
# group: [migration]

require ducklake

require parquet

# written by DuckDB 1.3.2, t.a was retyped and t.k renamed in the transaction that created t, v.c, v.s.x and v.d were
# renamed two or three times in one transaction and once more later, w.e was renamed twice in one transaction
unzip data/old_ducklake/same_begin_columns_v02.db.gz {TEST_DIR}/v02_same_begin_columns.db

statement ok
ATTACH 'ducklake:{TEST_DIR}/v02_same_begin_columns.db' AS lake (DATA_PATH 'data/old_ducklake/same_begin_columns_v02/',
    OVERRIDE_DATA_PATH TRUE, METADATA_CATALOG 'meta', AUTOMATIC_MIGRATION TRUE)

# a column has one version row for each begin
query IIII
SELECT c.column_name, c.column_type, c.begin_snapshot, v.end_snapshot FROM meta.ducklake_column c
LEFT JOIN meta.ducklake_column_visibility v
    ON c.table_id = v.table_id AND c.column_id = v.column_id AND c.begin_snapshot = v.row_snapshot
WHERE c.column_name NOT IN ('s', 'y') AND c.table_id > 1
ORDER BY c.table_id, c.column_id, c.begin_snapshot
----
a	int16	3	5
b	int16	5	NULL
k2	int32	3	6
k3	int32	6	NULL
c	int32	7	9
c2	int32	9	10
c3	int32	10	NULL
x	int32	7	9
x2	int32	9	11
x3	int32	11	NULL
d	int32	7	9
d3	int32	9	12
d4	int32	12	NULL
e	int32	13	15
e2	int32	15	NULL

query III
SELECT a, typeof(a), k2 FROM lake.t AT (VERSION => 4)
----
1	SMALLINT	5

query I
SELECT string_agg(column_name, ',') FROM (DESCRIBE SELECT * FROM lake.t AT (VERSION => 5))
----
b,k2

# a snapshot before the later change loads for every table of the lake
query I
SELECT * FROM lake.u AT (VERSION => 4)
----
7

query III
SELECT * FROM lake.v AT (VERSION => 9)
----
1	{'x2': 2, 'y': 3}	4

query III
SELECT (SELECT string_agg(column_name, ',') FROM (DESCRIBE SELECT * FROM lake.v AT (VERSION => 9))),
       (SELECT string_agg(column_name, ',') FROM (DESCRIBE SELECT * FROM lake.v AT (VERSION => 10))),
       (SELECT string_agg(column_name, ',') FROM (DESCRIBE SELECT * FROM lake.v AT (VERSION => 12)))
----
c2,s,d3	c3,s,d3	c3,s,d4

query III
SELECT * FROM lake.v
----
1	{'x3': 2, 'y': 3}	4

# the column that no later change ended
query I
SELECT string_agg(column_name, ',') FROM (DESCRIBE lake.w)
----
e2

query I
SELECT * FROM lake.w
----
9
