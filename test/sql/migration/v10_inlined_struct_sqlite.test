# name: test/sql/migration/v10_inlined_struct_sqlite.test
# description: the v1.1 migration rewrites the STRUCT values that DuckDB 1.5.6 inlined into a SQLite catalog as SQL literals
# group: [migration]

require ducklake

require parquet

require sqlite_scanner

# written by DuckDB 1.5.6 with fields of many types in t, row 2 has only NULL fields and row 3 a NULL struct, 1001
# dates in many, a struct of evolve that gains a field and renames one between its three rows, a string with a
# NUL character in nul, and a string with a quote and a backslash in bsq
unzip data/old_ducklake/inlined_struct_text.sqlite.gz {TEST_DIR}/v10_inlined_struct.sqlite

# a newer writer adds rows to the v1.0 catalog in the text format of v1.1
statement ok
ATTACH 'ducklake:sqlite:{TEST_DIR}/v10_inlined_struct.sqlite' AS lake (DATA_PATH '{TEST_DIR}/v10_inlined_struct_files/', OVERRIDE_DATA_PATH TRUE, DUCKLAKE_VERSION '1.0', DATA_INLINING_ROW_LIMIT 10)

statement ok
INSERT INTO lake.plain VALUES (2, {'x': 2, 'v': 'a\b, c'''}), (3, {'x': 3, 'v': 'a\b, c'}), (4, {'x': 4, 'v': 'CAST(a\b)'})

statement ok
DETACH lake

statement ok
ATTACH 'ducklake:sqlite:{TEST_DIR}/v10_inlined_struct.sqlite' AS lake (DATA_PATH '{TEST_DIR}/v10_inlined_struct_files/', OVERRIDE_DATA_PATH TRUE, DUCKLAKE_VERSION '1.1', AUTOMATIC_MIGRATION TRUE)

# the text DuckDB 1.5.6 wrote for a NUL character is not a plain literal and is kept
query I
SELECT s FROM __ducklake_metadata_lake.ducklake_inlined_data_5_7
----
{'v': CONCAT('a', chr(0), 'b')}

# the newer texts are kept, and so is a literal that reads as the same value
query I
SELECT s FROM __ducklake_metadata_lake.ducklake_inlined_data_2_2 ORDER BY id
----
{'x': 1, 'v': 'plain'}
{'x': 2, 'v': 'a\\b, c\''}
{'x': 3, 'v': 'a\\b, c'}
{'x': 4, 'v': 'CAST(a\\b)'}

loop flushed 0 2

query IIIIIIII
SELECT s.d, s.ts, s.tz = TIMESTAMPTZ '2020-01-01 10:11:12+00', s.t, s.i, s.u, hex(s.b), s.v = 'it''s, {x}'
FROM lake.t WHERE id = 1
----
2020-01-01	2020-01-01 10:11:12.5	true	10:11:12	1 month 2 days 00:00:03	00000000-0000-0000-0000-000000000001	00FF6162	true

query IIIIIIIII
SELECT isnan(s.n), s.x, s.f, s.dec, s.l, s.dl, s.m['k''1'], s.inner_s.a, s.inner_s.q = 'a''b' FROM lake.t WHERE id = 1
----
true	-7	1.5	12.34	[1, NULL, 3]	[2021-02-03]	1	2022-03-04	true

query III
SELECT id, s IS NULL, s.d IS NULL AND s.v IS NULL AND s.inner_s IS NULL FROM lake.t WHERE id > 1 ORDER BY id
----
2	false	true
3	true	true

query II
SELECT s.x, s.v = ['plain', 'a\b, c''', 'a\b, c', 'CAST(a\b)'][id] FROM lake.plain ORDER BY id
----
1	true
2	true
3	true
4	true

query III
SELECT id, s.c, s.b = ['', 'it''s', 'x''y'][id] FROM lake.evolve ORDER BY id
----
1	2020-01-01	NULL
2	2020-01-02	true
3	2020-01-03	true

query I
SELECT s.v = $$it's a\b$$ FROM lake.bsq
----
true

# more texts than one rewrite statement holds
query II
SELECT count(*), count(*) FILTER (WHERE s.d = DATE '2000-01-01' + id) FROM lake.many
----
1001	1001

statement ok
CALL ducklake_flush_inlined_data('lake', table_name => 't')

statement ok
CALL ducklake_flush_inlined_data('lake', table_name => 'plain')

statement ok
CALL ducklake_flush_inlined_data('lake', table_name => 'many')

statement ok
CALL ducklake_flush_inlined_data('lake', table_name => 'evolve')

endloop

query I
SELECT count(*) FROM ducklake_list_files('lake', 't')
----
1
