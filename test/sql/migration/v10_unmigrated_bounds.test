# name: test/sql/migration/v10_unmigrated_bounds.test
# description: a v1.0 catalog that is not migrated ignores the bounds that DuckDB 1.5.6 may have stored in the type of a file or of an older column type
# group: [migration]

require ducklake

require parquet

# the catalog of v10_retyped_bounds.test, written by DuckDB 1.5.6
unzip data/old_ducklake/migrate_bounds.db.gz {TEST_DIR}/v10_unmigrated_bounds.db

statement ok
ATTACH 'ducklake:{TEST_DIR}/v10_unmigrated_bounds.db' AS lake (DATA_PATH 'data/old_ducklake/migrate_bounds/', OVERRIDE_DATA_PATH TRUE, METADATA_CATALOG 'meta')

query I
SELECT value FROM meta.ducklake_metadata WHERE key = 'version'
----
1.0

query III
SELECT t, (SELECT count(*) FROM lake.ts WHERE t = (SELECT t FROM lake.ts)), (SELECT count(*) FROM lake.ts WHERE t < TIMESTAMP '2020-01-01 12:34:56.123457') FROM lake.ts
----
2020-01-01 12:34:56.123457	1	0

query I
SELECT count(*) FROM lake.tz WHERE t = (SELECT t FROM lake.tz)
----
1

query II
SELECT f, (SELECT count(*) FROM lake.dbl WHERE f = (SELECT f FROM lake.dbl)) FROM lake.dbl
----
0.10000000149011612	1

query II
SELECT f, (SELECT count(*) FROM lake.dbl2 WHERE f = 0.1) FROM lake.dbl2
----
0.1	1

query IIII
SELECT (SELECT count(*) FROM lake.r WHERE f = 0.10000000149011612), (SELECT count(*) FROM lake.r WHERE f >= 0.10000000149011612), min(f), max(f) FROM lake.r
----
1	3	0.10000000149011612	0.30000000000000004

query II
SELECT (SELECT count(*) FROM lake.st WHERE f = 0.10000000149011612), (SELECT count(*) FROM lake.st WHERE f >= 0.10000000149011612)
----
1	1

query III
SELECT (SELECT count(*) FROM lake.i2f WHERE f = 16777219), (SELECT count(*) FROM lake.tf WHERE f = 0.10000000149011612), (SELECT count(*) FROM lake.dc AT (VERSION => 22) WHERE f = 0.10000000149011612)
----
1	1	1

# the bounds stay as the older version wrote them, so it can still use them
query III
SELECT tbl.table_name, stats.min_value, stats.max_value
FROM meta.ducklake_file_column_stats stats JOIN meta.ducklake_table tbl USING (table_id)
WHERE tbl.table_name IN ('dbl', 'r') ORDER BY stats.data_file_id
----
dbl	0.1	0.1
r	0.1	0.1
r	0.25	0.30000000000000004

# the same bounds on the metadata catalog of the test config
test-env DUCKLAKE_CONNECTION {TEST_DIR}/v10_unmigrated_bounds_config.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS config_lake (DATA_PATH '{DATA_PATH}/v10_unmigrated_bounds_files', METADATA_CATALOG 'config_meta', DATA_INLINING_ROW_LIMIT 0, DUCKLAKE_VERSION '1.0')

statement ok
COPY (SELECT TIMESTAMP_NS '2020-01-01 12:34:56.123456789' AS t) TO '{DATA_PATH}/v10_unmigrated_bounds_ts_ns.parquet'

statement ok
CREATE TABLE config_lake.ts (t TIMESTAMP)

statement ok
CALL ducklake_add_data_files('config_lake', 'ts', '{DATA_PATH}/v10_unmigrated_bounds_ts_ns.parquet')

statement ok
CREATE TABLE config_lake.r (f FLOAT)

statement ok
INSERT INTO config_lake.r VALUES (0.1)

statement ok
ALTER TABLE config_lake.r ALTER COLUMN f TYPE DOUBLE

# the bounds that versions before the fixes wrote
statement ok
UPDATE config_meta.ducklake_file_column_stats SET min_value = '2020-01-01 12:34:56.123456789', max_value = '2020-01-01 12:34:56.123456789'
WHERE table_id = (SELECT table_id FROM config_meta.ducklake_table WHERE table_name = 'ts')

statement ok
UPDATE config_meta.ducklake_table_column_stats SET min_value = '2020-01-01 12:34:56.123456789', max_value = '2020-01-01 12:34:56.123456789'
WHERE table_id = (SELECT table_id FROM config_meta.ducklake_table WHERE table_name = 'ts')

statement ok
UPDATE config_meta.ducklake_file_column_stats SET min_value = '0.1', max_value = '0.1'
WHERE table_id = (SELECT table_id FROM config_meta.ducklake_table WHERE table_name = 'r')

statement ok
UPDATE config_meta.ducklake_table_column_stats SET min_value = '0.1', max_value = '0.1'
WHERE table_id = (SELECT table_id FROM config_meta.ducklake_table WHERE table_name = 'r')

# a FLOAT bound merged with a later DOUBLE bound that is still below the FLOAT value, a FLOAT bound that PostgreSQL
# prints in scientific notation, and an added file with a value below the range of FLOAT
statement ok
CREATE TABLE config_lake.merged (f FLOAT)

statement ok
INSERT INTO config_lake.merged VALUES (0.1)

statement ok
ALTER TABLE config_lake.merged ALTER COLUMN f TYPE DOUBLE

statement ok
INSERT INTO config_lake.merged VALUES (0.1000000001)

statement ok
CREATE TABLE config_lake.large (f FLOAT)

statement ok
INSERT INTO config_lake.large VALUES (1000000.1)

statement ok
ALTER TABLE config_lake.large ALTER COLUMN f TYPE DOUBLE

statement ok
UPDATE config_meta.ducklake_file_column_stats SET min_value = '0.1', max_value = '0.1'
WHERE data_file_id = (SELECT min(data_file_id) FROM config_meta.ducklake_data_file
	WHERE table_id = (SELECT table_id FROM config_meta.ducklake_table WHERE table_name = 'merged'))

statement ok
UPDATE config_meta.ducklake_table_column_stats SET min_value = '0.1', max_value = '0.1000000001'
WHERE table_id = (SELECT table_id FROM config_meta.ducklake_table WHERE table_name = 'merged')

statement ok
UPDATE config_meta.ducklake_file_column_stats SET min_value = '1000000.1', max_value = '1000000.1'
WHERE table_id = (SELECT table_id FROM config_meta.ducklake_table WHERE table_name = 'large')

statement ok
UPDATE config_meta.ducklake_table_column_stats SET min_value = '1000000.1', max_value = '1000000.1'
WHERE table_id = (SELECT table_id FROM config_meta.ducklake_table WHERE table_name = 'large')

statement ok
COPY (SELECT 1e-50::DOUBLE AS f) TO '{DATA_PATH}/v10_unmigrated_bounds_tiny.parquet'

statement ok
CREATE TABLE config_lake.tiny (f DOUBLE)

statement ok
CALL ducklake_add_data_files('config_lake', 'tiny', '{DATA_PATH}/v10_unmigrated_bounds_tiny.parquet')

statement ok
DETACH config_lake

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS config_lake (DATA_PATH '{DATA_PATH}/v10_unmigrated_bounds_files', METADATA_CATALOG 'config_meta')

query IIII
SELECT (SELECT count(*) FROM config_lake.merged WHERE f = 0.10000000149011612), (SELECT max(f) FROM config_lake.merged), (SELECT count(*) FROM config_lake.large WHERE f = 1000000.125), (SELECT count(*) FROM config_lake.tiny WHERE f = 1e-50)
----
1	0.10000000149011612	1	1

query IIII
SELECT (SELECT count(*) FROM config_lake.ts WHERE t = TIMESTAMP '2020-01-01 12:34:56.123457'), (SELECT max(t) FROM config_lake.ts), (SELECT count(*) FROM config_lake.r WHERE f = 0.10000000149011612), (SELECT min(f) FROM config_lake.r)
----
1	2020-01-01 12:34:56.123457	1	0.10000000149011612

query I
SELECT value FROM config_meta.ducklake_metadata WHERE key = 'version'
----
1.0
