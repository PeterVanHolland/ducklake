# name: test/sql/migration/v11_to_v20_dev1_expired_gap.test
# description: a 1.1 catalog with expired snapshots migrates to 2.0-dev1 with its newest gap recorded for time travel
# group: [migration]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS lake (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files',
    METADATA_CATALOG 'meta', DUCKLAKE_VERSION '1.1', DATA_INLINING_ROW_LIMIT 10)

statement ok
CREATE TABLE lake.t (a INTEGER)

loop i 1 6

statement ok
INSERT INTO lake.t VALUES ({i})

endloop

statement ok
SET VARIABLE t2 = (SELECT snapshot_time FROM lake.snapshots() WHERE snapshot_id = 2)

statement ok
SET VARIABLE t4 = (SELECT snapshot_time FROM lake.snapshots() WHERE snapshot_id = 4)

statement ok
SET VARIABLE t6 = (SELECT snapshot_time FROM lake.snapshots() WHERE snapshot_id = 6)

# a 1.1 catalog does not record the snapshots it expires
statement ok
CALL ducklake_expire_snapshots('lake', versions => [2])

statement ok
CALL ducklake_expire_snapshots('lake', versions => [4, 5])

# the migration to 2.0 converts no inlined rows, the flush writes them to files first
statement ok
CALL ducklake_flush_inlined_data('lake')

statement ok
DETACH lake

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS lake (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files',
    METADATA_CATALOG 'meta', AUTOMATIC_MIGRATION TRUE)

query I
SELECT list(snapshot_id ORDER BY snapshot_id) FROM lake.snapshots()
----
[0, 1, 3, 6, 7]

# the first snapshot after the newest gap records the bounds of the gap
query IT
SELECT snapshot_id, regexp_extract(changes_made, 'expired_snapshot.*') FROM meta.ducklake_snapshot_changes
WHERE changes_made LIKE '%expired_snapshot%'
----
6	expired_snapshot:4,expired_snapshot:5

statement error
SELECT * FROM lake.t AT (TIMESTAMP => getvariable('t4'))
----
snapshots 4 to 5 were expired and their commit times are not kept

# the times before an older gap are refused with it
statement error
SELECT * FROM lake.t AT (TIMESTAMP => getvariable('t2'))
----
snapshots 4 to 5 were expired and their commit times are not kept

query I
SELECT list(a ORDER BY a) FROM lake.t AT (TIMESTAMP => getvariable('t6'))
----
[1, 2, 3, 4, 5]
