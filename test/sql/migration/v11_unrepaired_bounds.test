# name: test/sql/migration/v11_unrepaired_bounds.test
# description: attaching a v1.1 catalog that DuckDB v2.0.0 migrated clears the bounds that v10_retyped_bounds.test clears in the migration
# group: [migration]

require ducklake

require parquet

# the catalog of v10_retyped_bounds.test, written by DuckDB 1.5.6 and migrated to v1.1 by DuckDB v2.0.0
unzip data/old_ducklake/migrate_bounds_v200.db.gz {TEST_DIR}/v11_unrepaired_bounds.db

# a read-only attach writes nothing
statement ok
ATTACH 'ducklake:{TEST_DIR}/v11_unrepaired_bounds.db' AS lake (DATA_PATH 'data/old_ducklake/migrate_bounds/', OVERRIDE_DATA_PATH TRUE, METADATA_CATALOG 'meta', READ_ONLY)

query I
SELECT count(*) FROM meta.ducklake_file_column_stats WHERE min_value IS NULL
----
0

statement ok
DETACH lake

statement ok
ATTACH 'ducklake:{TEST_DIR}/v11_unrepaired_bounds.db' AS lake (DATA_PATH 'data/old_ducklake/migrate_bounds/', OVERRIDE_DATA_PATH TRUE, METADATA_CATALOG 'meta')

query I
SELECT value FROM meta.ducklake_metadata WHERE key = 'version'
----
1.1

query III
SELECT t, (SELECT count(*) FROM lake.ts WHERE t = (SELECT t FROM lake.ts)), (SELECT count(*) FROM lake.ts WHERE t < TIMESTAMP '2020-01-01 12:34:56.123457') FROM lake.ts
----
2020-01-01 12:34:56.123457	1	0

query I
SELECT count(*) FROM lake.tz WHERE t = (SELECT t FROM lake.tz)
----
1

query II
SELECT f, (SELECT count(*) FROM lake.dbl WHERE f = (SELECT f FROM lake.dbl)) FROM lake.dbl
----
0.10000000149011612	1

query IIII
SELECT (SELECT count(*) FROM lake.r WHERE f = 0.10000000149011612), (SELECT count(*) FROM lake.r WHERE f >= 0.10000000149011612), min(f), max(f) FROM lake.r
----
1	3	0.10000000149011612	0.30000000000000004

query II
SELECT (SELECT count(*) FROM lake.st WHERE f = 0.10000000149011612), (SELECT count(*) FROM lake.st WHERE f >= 0.10000000149011612)
----
1	1

query III
SELECT (SELECT count(*) FROM lake.i2f WHERE f = 16777219), (SELECT count(*) FROM lake.tf WHERE f = 0.10000000149011612), (SELECT count(*) FROM lake.dc AT (VERSION => 22) WHERE f = 0.10000000149011612)
----
1	1	1

# the file bounds that the migration clears are cleared
query IIIII
SELECT tbl.table_name, stats.data_file_id, stats.column_id, stats.min_value, stats.max_value
FROM meta.ducklake_file_column_stats stats JOIN meta.ducklake_table tbl USING (table_id)
ORDER BY stats.data_file_id, stats.column_id
----
ts	1	1	NULL	NULL
tz	3	1	NULL	NULL
dbl	5	1	NULL	NULL
dbl2	7	1	NULL	NULL
r	8	1	NULL	NULL
r	9	1	0.25	0.30000000000000004
st	10	1	NULL	NULL
i2f	11	1	16777219	16777219
tf	12	1	NULL	NULL
dc	13	1	1	1
dc	13	2	NULL	NULL

# and the table bounds of the columns with such files
query III
SELECT tbl.table_name, stats.column_id, stats.min_value IS NULL AND stats.max_value IS NULL
FROM meta.ducklake_table_column_stats stats JOIN meta.ducklake_table tbl USING (table_id)
ORDER BY ALL
----
dbl	1	true
dbl2	1	true
dc	1	false
dc	2	true
i2f	1	false
r	1	true
st	1	true
tf	1	true
ts	1	true
tz	1	true

# the checked rows get exactness flags, so the next attach skips them
query II
SELECT tbl.table_name, stats.min_is_exact FROM meta.ducklake_file_column_stats stats
JOIN meta.ducklake_table tbl USING (table_id) WHERE stats.min_value IS NOT NULL ORDER BY stats.data_file_id, stats.column_id
----
r	false
i2f	false
dc	NULL

# the same rows on the metadata catalog of the test config
test-env DUCKLAKE_CONNECTION {TEST_DIR}/v11_unrepaired_bounds_config.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS config_lake (DATA_PATH '{DATA_PATH}/v11_unrepaired_bounds_files', METADATA_CATALOG 'config_meta', DATA_INLINING_ROW_LIMIT 0, DUCKLAKE_VERSION '1.1')

statement ok
COPY (SELECT TIMESTAMP_NS '2020-01-01 12:34:56.123456789' AS t) TO '{DATA_PATH}/v11_unrepaired_bounds_ts_ns.parquet'

statement ok
CREATE TABLE config_lake.ts (t TIMESTAMP)

statement ok
CALL ducklake_add_data_files('config_lake', 'ts', '{DATA_PATH}/v11_unrepaired_bounds_ts_ns.parquet')

statement ok
CREATE TABLE config_lake.r (f FLOAT)

statement ok
INSERT INTO config_lake.r VALUES (0.1)

statement ok
ALTER TABLE config_lake.r ALTER COLUMN f TYPE DOUBLE

# the rows that DuckDB 1.5.6 wrote and DuckDB v2.0.0 kept in its migration
statement ok
UPDATE config_meta.ducklake_file_column_stats SET min_value = '2020-01-01 12:34:56.123456789', max_value = '2020-01-01 12:34:56.123456789', min_is_exact = NULL, max_is_exact = NULL
WHERE table_id = (SELECT table_id FROM config_meta.ducklake_table WHERE table_name = 'ts')

statement ok
UPDATE config_meta.ducklake_table_column_stats SET min_value = '2020-01-01 12:34:56.123456789', max_value = '2020-01-01 12:34:56.123456789'
WHERE table_id = (SELECT table_id FROM config_meta.ducklake_table WHERE table_name = 'ts')

statement ok
UPDATE config_meta.ducklake_file_column_stats SET min_value = '0.1', max_value = '0.1', min_is_exact = NULL, max_is_exact = NULL
WHERE table_id = (SELECT table_id FROM config_meta.ducklake_table WHERE table_name = 'r')

statement ok
UPDATE config_meta.ducklake_table_column_stats SET min_value = '0.1', max_value = '0.1'
WHERE table_id = (SELECT table_id FROM config_meta.ducklake_table WHERE table_name = 'r')

# bounds that a v1.1 writer stores for an added file
statement ok
COPY (SELECT TIMESTAMPTZ '2020-01-01 12:34:56.123456+00' AS t) TO '{DATA_PATH}/v11_unrepaired_bounds_tz.parquet'

statement ok
CREATE TABLE config_lake.tz (t TIMESTAMPTZ)

statement ok
CALL ducklake_add_data_files('config_lake', 'tz', '{DATA_PATH}/v11_unrepaired_bounds_tz.parquet')

statement ok
DETACH config_lake

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS config_lake (DATA_PATH '{DATA_PATH}/v11_unrepaired_bounds_files', METADATA_CATALOG 'config_meta')

query I
SELECT count(*) FROM config_lake.tz WHERE t = TIMESTAMPTZ '2020-01-01 12:34:56.123456+00'
----
1

query I
SELECT count(*) FROM config_meta.ducklake_file_column_stats
WHERE table_id = (SELECT table_id FROM config_meta.ducklake_table WHERE table_name = 'tz') AND min_value IS NOT NULL
----
1

query IIII
SELECT (SELECT count(*) FROM config_lake.ts WHERE t = TIMESTAMP '2020-01-01 12:34:56.123457'), (SELECT max(t) FROM config_lake.ts), (SELECT count(*) FROM config_lake.r WHERE f = 0.10000000149011612), (SELECT min(f) FROM config_lake.r)
----
1	2020-01-01 12:34:56.123457	1	0.10000000149011612

query II
SELECT tbl.table_name, stats.min_value FROM config_meta.ducklake_file_column_stats stats
JOIN config_meta.ducklake_table tbl USING (table_id) WHERE tbl.table_name IN ('r', 'ts') ORDER BY tbl.table_name
----
r	NULL
ts	NULL

# two files of the stale bounds compacted into one, after which only the table bounds are stale, while another table
# still has a row that 1.0 wrote
statement ok
COPY (SELECT 0.25::DOUBLE AS f) TO '{DATA_PATH}/v11_unrepaired_bounds_other.parquet'

statement ok
CREATE TABLE config_lake.other (f DOUBLE)

statement ok
CALL ducklake_add_data_files('config_lake', 'other', '{DATA_PATH}/v11_unrepaired_bounds_other.parquet')

statement ok
UPDATE config_meta.ducklake_file_column_stats SET min_is_exact = NULL, max_is_exact = NULL
WHERE table_id = (SELECT table_id FROM config_meta.ducklake_table WHERE table_name = 'other')

statement ok
COPY (SELECT TIMESTAMP_NS '2020-01-01 12:34:56.123456789' AS t) TO '{DATA_PATH}/v11_unrepaired_bounds_c1.parquet'

statement ok
COPY (SELECT TIMESTAMP_NS '2020-01-01 12:34:56.123456789' AS t) TO '{DATA_PATH}/v11_unrepaired_bounds_c2.parquet'

statement ok
CREATE TABLE config_lake.compacted (t TIMESTAMP)

statement ok
CALL ducklake_add_data_files('config_lake', 'compacted', '{DATA_PATH}/v11_unrepaired_bounds_c*.parquet')

statement ok
UPDATE config_meta.ducklake_file_column_stats SET min_value = '2020-01-01 12:34:56.123456789', max_value = '2020-01-01 12:34:56.123456789', min_is_exact = NULL, max_is_exact = NULL
WHERE table_id = (SELECT table_id FROM config_meta.ducklake_table WHERE table_name = 'compacted')

statement ok
UPDATE config_meta.ducklake_table_column_stats SET min_value = '2020-01-01 12:34:56.123456789', max_value = '2020-01-01 12:34:56.123456789'
WHERE table_id = (SELECT table_id FROM config_meta.ducklake_table WHERE table_name = 'compacted')

statement ok
CALL ducklake_merge_adjacent_files('config_lake', 'compacted')

statement ok
CALL ducklake_expire_snapshots('config_lake', older_than => now())

query I
SELECT count(*) FROM config_meta.ducklake_file_column_stats
WHERE table_id = (SELECT table_id FROM config_meta.ducklake_table WHERE table_name = 'compacted') AND min_is_exact IS NULL
----
0

statement ok
DETACH config_lake

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS config_lake (DATA_PATH '{DATA_PATH}/v11_unrepaired_bounds_files', METADATA_CATALOG 'config_meta')

query II
SELECT (SELECT count(*) FROM config_lake.compacted WHERE t = TIMESTAMP '2020-01-01 12:34:56.123457'), (SELECT max(t) FROM config_lake.compacted)
----
2	2020-01-01 12:34:56.123457
