# name: test/sql/migration/v20_row_companions_orphan_fields.test
# description: the migration ends the field rows that releases before 1.5.3 left live below a dropped struct
# group: [migration]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta',
    DUCKLAKE_VERSION '1.1', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE dl.t (id INTEGER, s STRUCT(a INTEGER, n STRUCT(x INTEGER)))

statement ok
INSERT INTO dl.t VALUES (1, {'a': 1, 'n': {'x': 2}})

statement ok
CREATE TABLE dl.u (x INTEGER)

statement ok
INSERT INTO dl.u VALUES (7)

statement ok
ALTER TABLE dl.t DROP COLUMN s

# a transaction that changed fields and then dropped their struct left the rows of the changes live
statement ok
INSERT INTO meta.ducklake_column
SELECT * REPLACE (column_name || '2' AS column_name, end_snapshot AS begin_snapshot, NULL::BIGINT AS end_snapshot)
FROM meta.ducklake_column WHERE column_name IN ('a', 'n', 'x')

query IIII
SELECT column_name, begin_snapshot, end_snapshot, parent_column FROM meta.ducklake_column
WHERE table_id = 1 ORDER BY column_id, begin_snapshot
----
id	1	NULL	NULL
s	1	5	NULL
a	1	5	2
a2	5	NULL	2
n	1	5	2
n2	5	NULL	2
x	1	5	4
x2	5	NULL	4

statement ok
DETACH dl

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta',
    AUTOMATIC_MIGRATION TRUE, DATA_INLINING_ROW_LIMIT 0)

# a field row without a live parent ends at its begin, and so does the field below it
query III
SELECT c.column_name, c.begin_snapshot, v.end_snapshot FROM meta.ducklake_column c
LEFT JOIN meta.ducklake_column_visibility v
    ON c.table_id = v.table_id AND c.column_id = v.column_id AND c.begin_snapshot = v.row_snapshot
WHERE c.table_id = 1 AND c.begin_snapshot = 5 ORDER BY c.column_id
----
a2	5	5
n2	5	5
x2	5	5

query I
SELECT * FROM dl.t
----
1

query I
SELECT * FROM dl.u
----
7

query II
SELECT * FROM dl.t AT (VERSION => 4)
----
1	{'a': 1, 'n': {'x': 2}}

statement ok
INSERT INTO dl.t VALUES (2)

query I
SELECT * FROM dl.t ORDER BY id
----
1
2
