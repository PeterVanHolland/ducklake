# name: test/sql/migration/v20_row_companions_overlapping_columns.test
# description: the migration ends every version row of a column where its next row begins, as DuckDB 1.3 did not
# group: [migration]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta',
    DUCKLAKE_VERSION '1.1', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE dl.t (a INTEGER, s STRUCT(x INTEGER, y INTEGER))

statement ok
ALTER TABLE dl.t ADD COLUMN b INTEGER

statement ok
INSERT INTO dl.t VALUES (1, {'x': 2, 'y': 3}, 10)

statement ok
CREATE TABLE dl.u (x INTEGER)

statement ok
INSERT INTO dl.u VALUES (7)

statement ok
ALTER TABLE dl.t RENAME COLUMN b TO c

statement ok
ALTER TABLE dl.t RENAME COLUMN c TO b

statement ok
ALTER TABLE dl.t RENAME COLUMN b TO d

statement ok
ALTER TABLE dl.t RENAME COLUMN s.x TO x1

statement ok
ALTER TABLE dl.t RENAME COLUMN s.x1 TO x2

# a table with a data file written under every name of its column
statement ok
CREATE TABLE dl.m (a INTEGER, b INTEGER)

statement ok
INSERT INTO dl.m VALUES (1, 10)

statement ok
ALTER TABLE dl.m RENAME COLUMN b TO c

statement ok
INSERT INTO dl.m VALUES (2, 20)

statement ok
ALTER TABLE dl.m RENAME COLUMN c TO b

statement ok
INSERT INTO dl.m VALUES (3, 30)

statement ok
ALTER TABLE dl.m RENAME COLUMN b TO d

statement ok
INSERT INTO dl.m VALUES (4, 40)

# DuckDB 1.3 ended every earlier version row of a column at its last change
statement ok
UPDATE meta.ducklake_column SET end_snapshot = 8 WHERE column_name IN ('b', 'c') AND end_snapshot < 8

statement ok
UPDATE meta.ducklake_column SET end_snapshot = 10 WHERE column_name IN ('x', 'x1') AND parent_column IS NOT NULL

statement ok
UPDATE meta.ducklake_column SET end_snapshot = 17 WHERE column_name IN ('b', 'c') AND end_snapshot > 10

query III
SELECT column_name, begin_snapshot, end_snapshot FROM meta.ducklake_column
WHERE column_name NOT IN ('a', 's', 'y') ORDER BY table_id, column_id, begin_snapshot
----
x	1	10
x1	9	10
x2	10	NULL
b	2	8
c	6	8
b	7	8
d	8	NULL
x	4	NULL
b	11	17
c	13	17
b	15	17
d	17	NULL

statement ok
DETACH dl

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/{BASE_TEST_NAME}_files', METADATA_CATALOG 'meta',
    AUTOMATIC_MIGRATION TRUE, DATA_INLINING_ROW_LIMIT 0)

# every version row ends where the next row of its column begins
query III
SELECT c.column_name, v.row_snapshot, v.end_snapshot FROM meta.ducklake_column_visibility v
JOIN meta.ducklake_column c
    ON c.table_id = v.table_id AND c.column_id = v.column_id AND c.begin_snapshot = v.row_snapshot
ORDER BY v.table_id, v.column_id, v.row_snapshot
----
x	1	9
x1	9	10
b	2	6
c	6	7
b	7	8
b	11	13
c	13	15
b	15	17

query III
SELECT * FROM dl.t
----
1	{'x2': 2, 'y': 3}	10

query I
SELECT string_agg(column_name, ',') FROM (DESCRIBE SELECT * FROM dl.t AT (VERSION => 6))
----
a,s,c

query III
SELECT * FROM dl.t AT (VERSION => 6)
----
1	{'x': 2, 'y': 3}	10

query I
SELECT string_agg(column_name, ',') FROM (DESCRIBE SELECT * FROM dl.t AT (VERSION => 7))
----
a,s,b

query III
SELECT * FROM dl.t AT (VERSION => 7)
----
1	{'x': 2, 'y': 3}	10

query III
SELECT * FROM dl.t AT (VERSION => 9)
----
1	{'x1': 2, 'y': 3}	10

# a snapshot between the changes loads for every table of the lake
query I
SELECT * FROM dl.u AT (VERSION => 7)
----
7

query I
SELECT count(*) FROM ducklake_table_changes('dl', 'main', 'u', 7, 7)
----
0

# the files of every schema version bind to a table that loads
query I
SELECT string_agg(column_name, ',') FROM (DESCRIBE SELECT * FROM dl.m AT (VERSION => 14))
----
a,c

query II
SELECT * FROM dl.m AT (VERSION => 16) ORDER BY a
----
1	10
2	20
3	30

statement ok
CALL ducklake_merge_adjacent_files('dl')

statement ok
CHECKPOINT dl

query II
SELECT * FROM dl.m ORDER BY a
----
1	10
2	20
3	30
4	40
