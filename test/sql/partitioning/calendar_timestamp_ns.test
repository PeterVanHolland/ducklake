# name: test/sql/partitioning/calendar_timestamp_ns.test
# description: calendar partition values of a TIMESTAMP_NS floor the nanoseconds like the epoch transforms
# group: [partitioning]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS lake (DATA_PATH '{DATA_PATH}/calendar_timestamp_ns', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE lake.t (id INTEGER, ts TIMESTAMP_NS) PARTITIONED BY (year(ts), month(ts), day(ts), hour(ts), epoch_hour(ts))

# the last nanosecond of an hour, a day and a year, and the first of the next
statement ok
INSERT INTO lake.t VALUES
	(1, TIMESTAMP_NS '1969-12-31 23:59:59.999999999'),
	(2, TIMESTAMP_NS '1970-01-01 00:00:00.000000001'),
	(3, TIMESTAMP_NS '2026-03-15 10:59:59.999999999'),
	(4, TIMESTAMP_NS '2026-03-15 11:00:00.000000000')

query II
SELECT id, (SELECT string_agg(v.partition_value, ', ' ORDER BY v.partition_key_index)
	FROM __ducklake_metadata_lake.ducklake_file_partition_value v
	JOIN __ducklake_metadata_lake.ducklake_data_file f USING (data_file_id)
	WHERE split_part(f.path, '/', -1) = split_part(file, '/', -1)) AS partition_values
FROM (SELECT id, filename AS file FROM lake.t) ORDER BY id
----
1	1969, 12, 31, 23, -1
2	1970, 1, 1, 0, 0
3	2026, 3, 15, 10, 492658
4	2026, 3, 15, 11, 492659

# the stored values are unchanged
query I
SELECT ts FROM lake.t ORDER BY id
----
1969-12-31 23:59:59.999999999
1970-01-01 00:00:00.000000001
2026-03-15 10:59:59.999999999
2026-03-15 11:00:00

# the hive path follows the partition values
query I
SELECT count(*) FROM glob('{DATA_PATH}/calendar_timestamp_ns/main/t/year=1969/month=12/day=31/hour=23/epoch_hour=-1/*.parquet')
----
1
