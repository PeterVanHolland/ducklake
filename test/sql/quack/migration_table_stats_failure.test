# name: test/sql/quack/migration_table_stats_failure.test
# description: A rejected write of the migrated table stats on Quack leaves the catalog to be migrated again
# group: [quack]

require ducklake

require parquet

require-env DUCKLAKE_CONNECTION

require quack

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/quack_migration_table_stats', DATA_INLINING_ROW_LIMIT 0, DUCKLAKE_VERSION '1.0')

statement ok
CREATE TABLE dl.t (i INTEGER)

statement ok
INSERT INTO dl.t VALUES (1), (9)

# stats like v1.0 could leave, and a constraint on the server that rejects their repair
statement ok
CALL quack_query_by_name('__ducklake_metadata_dl', 'UPDATE ducklake_table_column_stats SET max_value = ''5''; UPDATE ducklake_table_stats SET record_count = 999')

statement ok
CALL quack_query_by_name('__ducklake_metadata_dl', 'ALTER TABLE ducklake_table_stats RENAME TO table_stats_data; CREATE VIEW ducklake_table_stats AS SELECT * FROM table_stats_data')

statement ok
DETACH dl

statement error
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/quack_migration_table_stats', DUCKLAKE_VERSION '1.1', AUTOMATIC_MIGRATION TRUE)
----
Failed to migrate DuckLake from v1.0 to v1.1

statement ok
ATTACH '{DUCKLAKE_CONNECTION}' AS server

statement ok
CALL quack_query_by_name('server', 'DROP VIEW ducklake_table_stats; ALTER TABLE table_stats_data RENAME TO ducklake_table_stats')

statement ok
DETACH server

# the failed migration left the version, so the stats are repaired now
statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/quack_migration_table_stats', DUCKLAKE_VERSION '1.1', AUTOMATIC_MIGRATION TRUE)

query I
SELECT count(*) FROM dl.t WHERE i = 9
----
1
