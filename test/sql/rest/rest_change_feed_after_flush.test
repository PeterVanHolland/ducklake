# name: test/sql/rest/rest_change_feed_after_flush.test
# description: A REST transaction reads the changes of inlined rows once after another connection flushes them
# group: [rest]

include test/template/rest_setup.test_template

statement ok
ATTACH 'ducklake:rest:{rest_server}' AS dl (DATA_INLINING_ROW_LIMIT 10)

statement ok
CREATE TABLE dl.t(i INTEGER)

statement ok
INSERT INTO dl.t VALUES (1), (2), (3)

statement ok
DELETE FROM dl.t WHERE i = 2

# the transaction loads its snapshot when it begins
statement ok
SET immediate_transaction_mode = true

statement ok con1
BEGIN TRANSACTION

query II con1
SELECT count(*), sum(i) FROM ducklake_table_insertions('dl', 'main', 't', 1, 2)
----
3	6

query II con1
SELECT count(*), sum(i) FROM ducklake_table_deletions('dl', 'main', 't', 1, 3)
----
1	2

query II con1
SELECT count(*), count(DISTINCT rowid) FROM ducklake_table_changes('dl', 'main', 't', 1, 3)
----
4	3

# the flush moves the rows into a data file and the deletion into a delete file
statement ok rest_db:rest_server_con
CALL ducklake_flush_inlined_data('rest_lake')

query II con1
SELECT count(*), sum(i) FROM ducklake_table_insertions('dl', 'main', 't', 1, 2)
----
3	6

query II con1
SELECT count(*), sum(i) FROM ducklake_table_deletions('dl', 'main', 't', 1, 3)
----
1	2

query IIII con1
SELECT snapshot_id, rowid, change_type, i FROM ducklake_table_changes('dl', 'main', 't', 1, 3) ORDER BY ALL
----
2	0	insert	1
2	1	insert	2
2	2	insert	3
3	1	delete	2

query II con1
SELECT count(*), sum(i) FROM dl.t
----
2	4

statement ok con1
COMMIT

query II
SELECT count(*), sum(i) FROM ducklake_table_insertions('dl', 'main', 't', 1, 2)
----
3	6

query II
SELECT count(*), sum(i) FROM ducklake_table_deletions('dl', 'main', 't', 1, 3)
----
1	2

include test/template/rest_teardown.test_template
