# name: test/sql/rest/rest_inlined_table_open_transaction.test
# description: A direct transaction keeps reading a table when REST clients inline rows and snapshots expire meanwhile
# group: [rest]

require ducklake

require parquet

statement ok
ATTACH 'ducklake:{TEST_DIR}/{BASE_TEST_NAME}_lake.db' AS lake
(DATA_PATH '{TEST_DIR}/{BASE_TEST_NAME}_files', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE lake.acc (id INTEGER, bal INTEGER)

statement ok
INSERT INTO lake.acc SELECT range + 1, 100 FROM range(8)

statement ok
ALTER TABLE lake.acc ADD COLUMN note VARCHAR

statement ok
SET VARIABLE rest_listen_uri = (SELECT listen_uri FROM ducklake_rest_serve('lake'))

set variable rest_server <variable:rest_listen_uri>

statement ok
ATTACH 'ducklake:rest:{rest_server}' AS rlake

statement ok direct
BEGIN

statement ok direct
UPDATE lake.acc SET bal = bal + 2 WHERE id = 1

# the server inlines the rows of the client, which creates the inlined table
statement ok client
UPDATE rlake.acc SET bal = bal + 19 WHERE id = 5

statement ok
CALL ducklake_expire_snapshots('lake', older_than => now())

# the commit of the client reads the inlined rows, which loads the schema of an expired snapshot again
statement ok client
UPDATE rlake.acc SET bal = bal - 19 WHERE id = 5

statement ok direct
UPDATE lake.acc SET bal = bal + 16 WHERE id = 2

query II direct
SELECT count(*), sum(bal) FROM lake.acc
----
8	818

statement ok direct
ROLLBACK

query II
SELECT count(*), sum(bal) FROM lake.acc
----
8	800

statement ok
SELECT * FROM ducklake_rest_stop(regexp_extract(getvariable('rest_listen_uri'), '^(.*://[^/]+)', 1))
