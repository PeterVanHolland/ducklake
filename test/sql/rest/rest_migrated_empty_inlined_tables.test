# name: test/sql/rest/rest_migrated_empty_inlined_tables.test
# description: A REST server skips inlined tables without rows, whose columns a migration by DuckDB 1.5.1 leaves unknown
# group: [rest]

include test/template/rest_setup.test_template

# written by DuckDB 1.4.4 and migrated by DuckDB 1.5.1, the table got its row before its column b was renamed
unzip data/old_ducklake/v03_migrated_empty_inlined_tables.db.gz {TEST_DIR}/rest_migrated_empty_inlined_tables.db

statement ok rest_db:rest_server_con
ATTACH 'ducklake:{TEST_DIR}/rest_migrated_empty_inlined_tables.db' AS migrated
(DATA_PATH '{TEST_DIR}/rest_migrated_empty_inlined_tables', OVERRIDE_DATA_PATH TRUE, AUTOMATIC_MIGRATION TRUE)

statement ok rest_db:rest_server_con
SET VARIABLE migrated_listen_uri = (SELECT listen_uri FROM ducklake_rest_serve('migrated',
port := regexp_extract(getvariable('rest_listen_uri'), ':([0-9]+)/', 1)::UBIGINT))

set variable migrated_server <variable:rest_server_con:migrated_listen_uri>

statement ok
ATTACH 'ducklake:rest:{migrated_server}' AS client

query II
FROM client.renamed
----
1	2

query II
SELECT a, c FROM client.table_insertions('renamed', 0, 10)
----
1	2

# after a flush the table without rows is the only inlined table left
statement ok rest_db:rest_server_con
CALL ducklake_flush_inlined_data('migrated', table_name => 'renamed')

query II
FROM client.renamed
----
1	2
