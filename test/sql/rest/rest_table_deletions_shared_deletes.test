# name: test/sql/rest/rest_table_deletions_shared_deletes.test
# description: The change feed of a REST client lists a deletion once that several delete files of a data file hold
# group: [rest]

require json

include test/template/rest_setup.test_template

statement ok
ATTACH 'ducklake:rest:{rest_server}' AS dl (DATA_INLINING_ROW_LIMIT 10)

statement ok
CREATE TABLE dl.t (id INTEGER, v INTEGER)

# three data files with the same rows apart from their offset
loop i 0 3

statement ok
INSERT INTO dl.t SELECT {i} * 1000 + k, k FROM range(200) t(k)

endloop

statement ok
DELETE FROM dl.t WHERE id < 20

statement ok
DELETE FROM dl.t WHERE id BETWEEN 1020 AND 1049

statement ok
DELETE FROM dl.t WHERE id BETWEEN 2000 AND 2059

# an older release could leave delete files that hold the rows of other visible delete files, here the delete files
# of the other two data files become delete files of the first, and the last one holds the rows of the other two
statement ok rest_db:rest_server_con
UPDATE __ducklake_metadata_rest_lake.ducklake_delete_file SET data_file_id = 0 WHERE data_file_id IN (1, 2)

query IIII
SELECT snapshot_id, count(*), min(id), max(id) FROM ducklake_table_deletions('dl', 'main', 't', 5, 7)
GROUP BY ALL ORDER BY ALL
----
5	20	0	19
6	30	20	49
7	10	50	59

# the server lists the data file once for each of its delete files
query III
SELECT count(*), count(DISTINCT file.path), count(DISTINCT delete_file.path)
FROM ducklake_rest_rows('{rest_server}', 'POST', '/v1/tables/1/changes',
	'{"start_snapshot_id": 5, "changes": "deletions"}', part := 'deletions')
----
3	1	3

# the last delete file is listed once for each of the two delete files that were visible before it
query III
SELECT count(*), count(DISTINCT delete_file.path), count(DISTINCT previous_delete_file.path)
FROM ducklake_rest_rows('{rest_server}', 'POST', '/v1/tables/1/changes',
	'{"start_snapshot_id": 7, "changes": "deletions"}', part := 'deletions')
----
2	1	2

query IIII
SELECT snapshot_id, count(*), min(id), max(id) FROM ducklake_table_deletions('dl', 'main', 't', 7, 7)
GROUP BY ALL ORDER BY ALL
----
7	10	50	59

# a new delete file holds the rows of the delete file it replaces with their snapshots
statement ok
DELETE FROM dl.t WHERE id BETWEEN 60 AND 79

query IIII
SELECT snapshot_id, count(*), min(id), max(id) FROM ducklake_table_deletions('dl', 'main', 't', 7, 8)
GROUP BY ALL ORDER BY ALL
----
7	10	50	59
8	20	60	79

statement ok
DETACH dl

include test/template/rest_teardown.test_template
