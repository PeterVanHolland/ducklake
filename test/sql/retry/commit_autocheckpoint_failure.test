# name: test/sql/retry/commit_autocheckpoint_failure.test
# description: a metadata COMMIT that is durable but fails its autocheckpoint keeps the data files it wrote
# group: [retry]

require ducklake

require parquet

# only a DuckDB metadata database checkpoints at its commit, the same file is attached twice
test-env DUCKDB_METADATA {TEST_DIR}/commit_autocheckpoint_failure.db

test-env DATA_PATH {TEST_DIR}

# the alias puts a word of the retried errors into the name of the metadata database, which every error of it names
statement ok
ATTACH 'ducklake:{DUCKDB_METADATA}' AS unique_lake (DATA_PATH '{DATA_PATH}/commit_autocheckpoint_failure', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE unique_lake.t (i INTEGER)

# the commit writes its WAL before the checkpoint, a checkpoint that replaces the WAL write fails the commit instead
statement ok
SET auto_checkpoint_skip_wal_threshold = 9999999999

statement ok
BEGIN

statement ok
INSERT INTO unique_lake.t VALUES (1)

statement ok
SET wal_autocheckpoint = '1B'

statement ok
SET debug_checkpoint_abort = 'BEFORE_HEADER_NON_FATAL'

# the error of the first attempt is reported, a commit that may have taken effect is not retried
statement error
COMMIT
----
<REGEX>:.*Failed to commit DuckLake transaction\.\nThe commit may have taken effect, so the files it wrote are kept\. ducklake_delete_orphaned_files removes them if it did not\.\nTransaction COMMIT succeeded and is durable, but the autocheckpoint failed\..*__ducklake_metadata_unique_lake.*

statement ok
SET debug_checkpoint_abort = 'NONE'

statement ok
RESET wal_autocheckpoint

query I
SELECT count(*) FROM glob('{DATA_PATH}/commit_autocheckpoint_failure/**/*.parquet')
----
1

# the invalidated metadata database is attached again
statement ok
DETACH unique_lake

statement ok
ATTACH 'ducklake:{DUCKDB_METADATA}' AS unique_lake (DATA_PATH '{DATA_PATH}/commit_autocheckpoint_failure', DATA_INLINING_ROW_LIMIT 0)

query I
SELECT i FROM unique_lake.t
----
1

# the committed snapshot references the file, so it is no orphan
statement ok
CALL ducklake_delete_orphaned_files('unique_lake', cleanup_all => true)

query I
SELECT count(*) FROM glob('{DATA_PATH}/commit_autocheckpoint_failure/**/*.parquet')
----
1

# a commit that fails before its COMMIT is sent still removes its files
statement ok con2
SET ducklake_max_retry_count = 0

statement ok con1
BEGIN

statement ok con2
BEGIN

statement ok con1
INSERT INTO unique_lake.t VALUES (2)

statement ok con2
INSERT INTO unique_lake.t VALUES (3)

statement ok con1
COMMIT

statement error con2
COMMIT
----
Exceeded the maximum retry count of 0

query I
SELECT count(*) FROM glob('{DATA_PATH}/commit_autocheckpoint_failure/**/*.parquet')
----
2

query I
SELECT i FROM unique_lake.t ORDER BY i
----
1
2
