# name: test/sql/retry/postgres_dropped_cached_inlined_table.test
# description: a rewrite commit retries when another attach dropped the only inlined table it cached
# group: [retry]

require ducklake

require parquet

require postgres_scanner

require-env DUCKLAKE_CI

require-env DUCKLAKE_CONNECTION

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH '{DUCKLAKE_CONNECTION}' AS pg

statement ok
CALL postgres_execute('pg', 'DROP SCHEMA IF EXISTS dropped_cached_inlined CASCADE')

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl
(DATA_PATH '{DATA_PATH}/dropped_cached_inlined', METADATA_SCHEMA 'dropped_cached_inlined', DATA_INLINING_ROW_LIMIT 10)

statement ok
CREATE TABLE dl.t (i INTEGER)

statement ok
INSERT INTO dl.t VALUES (1), (2)

statement ok
CALL ducklake_flush_inlined_data('dl')

statement ok
DELETE FROM dl.t WHERE i = 1

statement ok
CALL ducklake_flush_inlined_data('dl')

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl2
(DATA_PATH '{DATA_PATH}/dropped_cached_inlined', METADATA_SCHEMA 'dropped_cached_inlined', DATA_INLINING_ROW_LIMIT 10)

statement ok con1
BEGIN

statement ok con1
CALL ducklake_rewrite_data_files('dl', 't', delete_threshold => 0)

# the ALTER supersedes the only inlined table and the flush drops it
statement ok
ALTER TABLE dl2.t ADD COLUMN j INTEGER

statement ok
INSERT INTO dl2.t VALUES (3, 3)

statement ok
CALL ducklake_flush_inlined_data('dl2')

query I
SELECT * FROM postgres_query('pg', 'SELECT to_regclass(''dropped_cached_inlined.ducklake_inlined_data_1_1'') IS NULL')
----
true

statement ok con1
COMMIT

query II
SELECT count(*), sum(i) FROM dl2.t
----
2	5

statement ok
DETACH dl2

statement ok
DETACH dl

statement ok
CALL postgres_execute('pg', 'DROP SCHEMA dropped_cached_inlined CASCADE')
