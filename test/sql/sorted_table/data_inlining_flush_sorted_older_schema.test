# name: test/sql/sorted_table/data_inlining_flush_sorted_older_schema.test
# description: A sorted flush reads the columns of older inlined rows in the types and fields the table has now
# group: [sorted_table]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl
(DATA_PATH '{DATA_PATH}/data_inlining_flush_sorted_older_schema', DATA_INLINING_ROW_LIMIT 10)

# the sum overflows in the type that the rows were inlined with
statement ok
CREATE TABLE dl.retyped (a INTEGER, b INTEGER)

statement ok
INSERT INTO dl.retyped VALUES (1, 2000000000), (2, 1), (3, 1500000000)

statement ok
ALTER TABLE dl.retyped ALTER COLUMN b TYPE BIGINT

statement ok
ALTER TABLE dl.retyped SET SORTED BY ((b + b))

statement ok
CALL ducklake_flush_inlined_data('dl', table_name => 'retyped')

query II
FROM dl.retyped
----
2	1
3	1500000000
1	2000000000

# the sort names a field that the inlined rows have under its old name
statement ok
CREATE TABLE dl.renamed (a INTEGER, s STRUCT(x INTEGER))

statement ok
INSERT INTO dl.renamed VALUES (1, {'x': 5}), (2, {'x': 3}), (3, NULL)

statement ok
ALTER TABLE dl.renamed RENAME COLUMN s.x TO y

statement ok
ALTER TABLE dl.renamed SET SORTED BY (struct_extract(s, 'y'))

statement ok
CALL ducklake_flush_inlined_data('dl', table_name => 'renamed')

query II
FROM dl.renamed
----
2	{'y': 3}
1	{'y': 5}
3	NULL

query II
SELECT table_name, file_count FROM ducklake_table_info('dl') ORDER BY table_name
----
renamed	1
retyped	1

statement ok
CHECKPOINT dl
