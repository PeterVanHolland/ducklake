# name: test/sql/stats/retype_bounds_other_type.test
# description: file bounds of an older type do not prune rows after ALTER COLUMN TYPE
# group: [stats]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/retype_bounds_other_type', DATA_INLINING_ROW_LIMIT 0)

statement ok
USE ducklake

# an added file keeps the true and false bounds of its footer
statement ok
COPY (SELECT true AS v) TO '{DATA_PATH}/retype_bounds_other_type_bool.parquet'

statement ok
CREATE TABLE booleans (v BOOLEAN)

statement ok
CALL ducklake_add_data_files('ducklake', 'booleans', '{DATA_PATH}/retype_bounds_other_type_bool.parquet')

statement ok
ALTER TABLE booleans ALTER COLUMN v TYPE INTEGER

query I
SELECT count(*) FROM booleans WHERE v = 1
----
1

statement ok
ALTER TABLE booleans ALTER COLUMN v TYPE DOUBLE

query I
SELECT count(*) FROM booleans WHERE v = 1
----
1

# a wide DECIMAL reads as another DOUBLE than its bound text
statement ok
CREATE TABLE decimals (v DECIMAL(38,0))

statement ok
INSERT INTO decimals VALUES ('-9007199254740994')

statement ok
ALTER TABLE decimals ALTER COLUMN v TYPE DOUBLE

statement ok
SET VARIABLE scanned = (SELECT v FROM decimals)

query I
SELECT count(*) FROM decimals WHERE v = getvariable('scanned')
----
1

# bounds that read as the new type still prune
statement ok
CREATE TABLE native_booleans (v BOOLEAN)

statement ok
INSERT INTO native_booleans VALUES (true)

statement ok
INSERT INTO native_booleans VALUES (false)

statement ok
ALTER TABLE native_booleans ALTER COLUMN v TYPE INTEGER

query II
EXPLAIN ANALYZE SELECT count(*) FROM native_booleans WHERE v = 1
----
analyzed_plan	<REGEX>:.*Total Files Read: 1\s.*

statement ok
CREATE TABLE narrow_decimals (v DECIMAL(15,2))

statement ok
INSERT INTO narrow_decimals VALUES (1.25)

statement ok
INSERT INTO narrow_decimals VALUES (7.5)

statement ok
ALTER TABLE narrow_decimals ALTER COLUMN v TYPE DOUBLE

query II
EXPLAIN ANALYZE SELECT count(*) FROM narrow_decimals WHERE v = 7.5
----
analyzed_plan	<REGEX>:.*Total Files Read: 1\s.*
