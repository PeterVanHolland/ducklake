# name: test/sql/table_changes/table_changes_expired_rewrite_snapshots.test
# description: the change feed keeps the changes of a rewritten file when the snapshots around the rewrite are expired
# group: [table_changes]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/table_changes_expired_rewrite_snapshots', DATA_INLINING_ROW_LIMIT 0)

statement ok
USE ducklake

# the snapshot of the delete is expired, the rewrite snapshot stays
statement ok
CREATE TABLE t(a INT)

statement ok
INSERT INTO t VALUES (1), (2)

statement ok
INSERT INTO t VALUES (3), (4)

statement ok
DELETE FROM t WHERE a = 3

statement ok
CALL ducklake_rewrite_data_files('ducklake', 't', delete_threshold => 0)

query I
SELECT changes FROM snapshots() WHERE snapshot_id = 5
----
{rewrite_delete=[1]}

query IIII
SELECT snapshot_id, rowid, change_type, a FROM table_changes('t', 3, 5) ORDER BY ALL
----
3	2	insert	3
3	3	insert	4
4	2	delete	3

statement ok
CALL ducklake_expire_snapshots('ducklake', versions => [4])

# the delete file is gone, so the rewrite reports what it ended and wrote
query IIII
SELECT snapshot_id, rowid, change_type, a FROM table_changes('t', 3, 5) ORDER BY ALL
----
3	2	insert	3
3	3	insert	4
5	2	delete	3
5	3	update_postimage	4
5	3	update_preimage	4

query I
SELECT list(a ORDER BY a) FROM t AT (VERSION => 5)
----
[1, 2, 4]

query I
SELECT COUNT(*) FROM table_changes('t', 5, 5)
----
3

# the snapshot of the insert is expired too, so the rewritten file is gone and its output is the insert (the expiry
# above is snapshot 6)
statement ok
CREATE TABLE u(a INT)

statement ok
INSERT INTO u VALUES (1), (2)

statement ok
INSERT INTO u VALUES (3), (4)

statement ok
DELETE FROM u WHERE a = 3

statement ok
CALL ducklake_rewrite_data_files('ducklake', 'u', delete_threshold => 0)

statement ok
CALL ducklake_expire_snapshots('ducklake', versions => [9, 10])

query IIII
SELECT snapshot_id, rowid, change_type, a FROM table_changes('u', 8, 11) ORDER BY ALL
----
8	0	insert	1
8	1	insert	2
11	3	insert	4

query I
SELECT list(a ORDER BY a) FROM u AT (VERSION => 11)
----
[1, 2, 4]

# the rewrite snapshot itself is expired, so a later update of its output keeps its delete
statement ok
CREATE TABLE v(id INTEGER, v VARCHAR)

statement ok
INSERT INTO v VALUES (1, 'a'), (2, 'b'), (3, 'c')

statement ok
DELETE FROM v WHERE id = 1

statement ok
DELETE FROM v WHERE id = 2

statement ok
CALL ducklake_rewrite_data_files('ducklake', 'v', delete_threshold => 0)

statement ok
UPDATE v SET v = 'x' WHERE id = 3

query IIIII
SELECT snapshot_id, rowid, change_type, id, v FROM table_changes('v', 16, 18) ORDER BY ALL
----
16	1	delete	2	b
18	2	update_postimage	3	x
18	2	update_preimage	3	c

statement ok
CALL ducklake_expire_snapshots('ducklake', versions => [17])

query IIIII
SELECT snapshot_id, rowid, change_type, id, v FROM table_changes('v', 16, 18) ORDER BY ALL
----
16	1	delete	2	b
17	2	delete	3	c
18	2	insert	3	x

query I
SELECT list((id, v) ORDER BY id) FROM v AT (VERSION => 18)
----
[(3, x)]
