# name: test/sql/table_changes/table_changes_expired_rewrite_snapshots.test
# description: the change feed keeps the changes of a rewritten file when the snapshots around the rewrite are expired
# group: [table_changes]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/table_changes_expired_rewrite_snapshots', METADATA_CATALOG 'ducklake_meta', DATA_INLINING_ROW_LIMIT 0)

statement ok
USE ducklake

# the snapshot of the delete is expired, the rewrite snapshot stays
statement ok
CREATE TABLE t(a INT)

statement ok
INSERT INTO t VALUES (1), (2)

statement ok
INSERT INTO t VALUES (3), (4)

statement ok
DELETE FROM t WHERE a = 3

statement ok
CALL ducklake_rewrite_data_files('ducklake', 't', delete_threshold => 0)

query I
SELECT changes FROM snapshots() WHERE snapshot_id = 5
----
{rewrite_delete=[1]}

query IIII
SELECT snapshot_id, rowid, change_type, a FROM table_changes('t', 3, 5) ORDER BY ALL
----
3	2	insert	3
3	3	insert	4
4	2	delete	3

statement ok
CALL ducklake_expire_snapshots('ducklake', versions => [4])

# the rewritten file and its delete file stay while the rewrite snapshot exists, so the feed is unchanged
query I
SELECT count(*) FROM ducklake_meta.ducklake_delete_file WHERE table_id = 1
----
1

query IIII
SELECT snapshot_id, rowid, change_type, a FROM table_changes('t', 3, 5) ORDER BY ALL
----
3	2	insert	3
3	3	insert	4
4	2	delete	3

query I
SELECT COUNT(*) FROM table_changes('t', 5, 5)
----
0

# once the rewrite snapshot is expired too, the delete file goes and the rewrite reports what it ended and wrote
statement ok
CALL ducklake_expire_snapshots('ducklake', versions => [5])

query I
SELECT count(*) FROM ducklake_meta.ducklake_delete_file WHERE table_id = 1
----
0

query IIII
SELECT snapshot_id, rowid, change_type, a FROM table_changes('t', 3, 7) ORDER BY ALL
----
3	2	insert	3
3	3	insert	4
5	2	delete	3
5	3	update_postimage	4
5	3	update_preimage	4

query I
SELECT list(a ORDER BY a) FROM t AT (VERSION => 7)
----
[1, 2, 4]

# the snapshots of the insert and the delete are expired, the rewritten file stays and reports both
statement ok
CREATE TABLE u(a INT)

statement ok
INSERT INTO u VALUES (1), (2)

statement ok
INSERT INTO u VALUES (3), (4)

statement ok
DELETE FROM u WHERE a = 3

statement ok
CALL ducklake_rewrite_data_files('ducklake', 'u', delete_threshold => 0)

statement ok
CALL ducklake_expire_snapshots('ducklake', versions => [10, 11])

query IIII
SELECT snapshot_id, rowid, change_type, a FROM table_changes('u', 9, 12) ORDER BY ALL
----
9	0	insert	1
9	1	insert	2
10	2	insert	3
10	3	insert	4
11	2	delete	3

query I
SELECT list(a ORDER BY a) FROM u AT (VERSION => 12)
----
[1, 2, 4]

# an expired snapshot of another table before the rewrite changes nothing
statement ok
CREATE TABLE w(a INT)

statement ok
INSERT INTO w VALUES (1), (2), (3), (4)

statement ok
DELETE FROM w WHERE a = 3

statement ok
CREATE TABLE unrelated(x INT)

statement ok
CALL ducklake_rewrite_data_files('ducklake', 'w', delete_threshold => 0)

statement ok
CALL ducklake_expire_snapshots('ducklake', versions => [17])

query IIII
SELECT snapshot_id, rowid, change_type, a FROM table_changes('w', 15, 18) ORDER BY ALL
----
15	0	insert	1
15	1	insert	2
15	2	insert	3
15	3	insert	4
16	2	delete	3

query I
SELECT COUNT(*) FROM table_changes('w', 18, 18)
----
0

# a table named like the rewrite marker does not keep a deleted file
statement ok
CREATE TABLE z(a INT)

statement ok
INSERT INTO z VALUES (1), (2)

statement ok
BEGIN

statement ok
DELETE FROM z

statement ok
CREATE TABLE "rewrite_delete:"(x INT)

statement ok
COMMIT

query I
SELECT count(*) FROM ducklake_meta.ducklake_data_file
WHERE table_id = (SELECT table_id FROM ducklake_meta.ducklake_table WHERE table_name = 'z')
----
1

statement ok
CALL ducklake_expire_snapshots('ducklake', versions => [21])

query I
SELECT count(*) FROM ducklake_meta.ducklake_data_file
WHERE table_id = (SELECT table_id FROM ducklake_meta.ducklake_table WHERE table_name = 'z')
----
0

# the rewrite snapshot itself is expired, so a later update of its output keeps its delete
statement ok
CREATE TABLE v(id INTEGER, v VARCHAR)

statement ok
INSERT INTO v VALUES (1, 'a'), (2, 'b'), (3, 'c')

statement ok
DELETE FROM v WHERE id = 1

statement ok
DELETE FROM v WHERE id = 2

statement ok
CALL ducklake_rewrite_data_files('ducklake', 'v', delete_threshold => 0)

statement ok
UPDATE v SET v = 'x' WHERE id = 3

query IIIII
SELECT snapshot_id, rowid, change_type, id, v FROM table_changes('v', 27, 29) ORDER BY ALL
----
27	1	delete	2	b
29	2	update_postimage	3	x
29	2	update_preimage	3	c

statement ok
CALL ducklake_expire_snapshots('ducklake', versions => [28])

query IIIII
SELECT snapshot_id, rowid, change_type, id, v FROM table_changes('v', 27, 29) ORDER BY ALL
----
27	1	delete	2	b
28	2	delete	3	c
29	2	insert	3	x

query I
SELECT list((id, v) ORDER BY id) FROM v AT (VERSION => 29)
----
[(3, x)]
