# name: test/sql/table_changes/table_changes_rewrite_expired.test
# description: Once the snapshots around a rewrite are expired, the change feed reports the rewrite like other changes
# group: [table_changes]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS dl (DATA_PATH '{DATA_PATH}/table_changes_rewrite_expired', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE dl.t (id INTEGER, v VARCHAR)

statement ok
INSERT INTO dl.t VALUES (1, 'a'), (2, 'b'), (3, 'c')

statement ok
DELETE FROM dl.t WHERE id = 1

statement ok
DELETE FROM dl.t WHERE id = 2

statement ok
CALL ducklake_rewrite_data_files('dl', 't', delete_threshold => 0)

statement ok
UPDATE dl.t SET v = 'x' WHERE id = 3

query IIII
SELECT snapshot_id, change_type, id, v FROM dl.table_changes('t', 4, 6) ORDER BY ALL
----
4	delete	2	b
6	update_postimage	3	x
6	update_preimage	3	c

# expiring the rewrite cleans up the file with the update of its rows
statement ok
CALL ducklake_expire_snapshots('dl', versions => [5])

query IIII
SELECT snapshot_id, change_type, id, v FROM dl.table_changes('t', 4, 6) ORDER BY ALL
----
4	delete	2	b
5	delete	3	c
6	insert	3	x

query II
SELECT list((id, v) ORDER BY id), (SELECT list((id, v) ORDER BY id) FROM dl.t AT (VERSION => 6)) FROM dl.t AT (VERSION => 4)
----
[(3, c)]	[(3, x)]

# expiring the snapshot before a rewrite cleans up the deletions the rewrite dropped
statement ok
CREATE TABLE dl.u (id INTEGER)

statement ok
INSERT INTO dl.u SELECT range FROM range(5)

statement ok
DELETE FROM dl.u WHERE id = 0

statement ok
CALL ducklake_rewrite_data_files('dl', 'u', delete_threshold => 0)

statement ok
DELETE FROM dl.u WHERE id = 4

query III
SELECT snapshot_id, change_type, id FROM dl.table_changes('u', 9, 12) WHERE change_type IN ('insert', 'delete') ORDER BY ALL
----
9	insert	0
9	insert	1
9	insert	2
9	insert	3
9	insert	4
10	delete	0
12	delete	4

statement ok
CALL ducklake_expire_snapshots('dl', versions => [10])

query III
SELECT snapshot_id, change_type, id FROM dl.table_changes('u', 9, 12) WHERE change_type IN ('insert', 'delete') ORDER BY ALL
----
9	insert	0
9	insert	1
9	insert	2
9	insert	3
9	insert	4
11	delete	0
12	delete	4

# applying the change feed gives the current rows
query II
SELECT sum(CASE WHEN change_type IN ('insert', 'update_postimage') THEN 1 ELSE -1 END), (SELECT count(*) FROM dl.u)
FROM dl.table_changes('u', 9, 12)
----
3	3

# a feed that starts at the rewrite does not need the expired snapshot before it
query III
SELECT snapshot_id, change_type, id FROM dl.table_changes('u', 11, 12) ORDER BY ALL
----
12	delete	4
