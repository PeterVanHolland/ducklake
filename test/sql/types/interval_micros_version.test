# name: test/sql/types/interval_micros_version.test
# description: DuckLake 1.0 catalogs keep writing INTERVAL files with milliseconds, and migrated catalogs read both layouts
# group: [types]

require ducklake

require parquet

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{TEST_DIR}/interval_micros_version.db' AS ducklake (DATA_PATH '{DATA_PATH}/interval_micros_version', METADATA_CATALOG 'interval_meta', DATA_INLINING_ROW_LIMIT 0, DUCKLAKE_VERSION '1.0')

statement ok
CREATE TABLE ducklake.t (id INTEGER, x INTERVAL);

# 1.0 readers expect the Parquet INTERVAL, which keeps milliseconds
statement ok
INSERT INTO ducklake.t VALUES (1, INTERVAL '1500 microseconds');

query II
SELECT id, x::VARCHAR FROM ducklake.t
----
1	00:00:00.001

statement ok
DETACH ducklake

statement ok
ATTACH 'ducklake:{TEST_DIR}/interval_micros_version.db' AS ducklake (DATA_PATH '{DATA_PATH}/interval_micros_version', METADATA_CATALOG 'interval_meta', DATA_INLINING_ROW_LIMIT 0, AUTOMATIC_MIGRATION TRUE)

statement ok
INSERT INTO ducklake.t VALUES (2, INTERVAL '2500 microseconds');

query II
SELECT id, x::VARCHAR FROM ducklake.t ORDER BY id
----
1	00:00:00.001
2	00:00:00.0025

query I
SELECT id FROM ducklake.t WHERE x = INTERVAL '2500 microseconds'
----
2

statement ok
CALL ducklake_merge_adjacent_files('ducklake', 't')

query II
SELECT id, x::VARCHAR FROM ducklake.t ORDER BY id
----
1	00:00:00.001
2	00:00:00.0025

statement ok
DETACH ducklake

# a 1.0 catalog written with DuckLake pinned to 1.0 reads as before, also next to new microseconds once migrated
unzip data/old_ducklake/v10_interval.db.gz {TEST_DIR}/v10_interval.db

statement ok
ATTACH 'ducklake:{TEST_DIR}/v10_interval.db' AS legacy (DATA_PATH 'data/old_ducklake/v10_interval/', OVERRIDE_DATA_PATH TRUE, METADATA_CATALOG 'legacy_interval_meta')

query II
SELECT id, x::VARCHAR FROM legacy.t ORDER BY id
----
1	00:00:00.001
2	1 year 2 days 03:00:00
3	NULL

statement ok
DETACH legacy

statement ok
ATTACH 'ducklake:{TEST_DIR}/v10_interval.db' AS legacy (DATA_PATH 'data/old_ducklake/v10_interval/', OVERRIDE_DATA_PATH TRUE, METADATA_CATALOG 'legacy_interval_meta', AUTOMATIC_MIGRATION TRUE, DATA_INLINING_ROW_LIMIT 10)

statement ok
INSERT INTO legacy.t VALUES (4, INTERVAL '1500 microseconds');

query II
SELECT id, x::VARCHAR FROM legacy.t ORDER BY id
----
1	00:00:00.001
2	1 year 2 days 03:00:00
3	NULL
4	00:00:00.0015

query I
SELECT id FROM legacy.t WHERE x = INTERVAL '1500 microseconds'
----
4
